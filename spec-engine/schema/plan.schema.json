{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tess-os.dev/spec-engine/contracts/plan.schema.json",
  "title": "Spec Engine — Plan Contract",
  "description": "Machine-checkable form of the pre-approval draft (TESS-VISION-AND-BUILD-SPEC.html Phase 1 Epic E2, deliverable (3): 'Plan -> Xavier/user approval gate -> complete spec generation'). This is the exact shape `spec_engine.types.Plan.to_log_record()` emits — what gets shown/logged at the approval gate before a SpecDocument exists. Shares the same content dataclass shapes as spec.schema.json (what_it_does/how_it_looks/how_it_works/data_model/open_questions) since approval promotes this content verbatim into the SpecDocument.",
  "type": "object",
  "properties": {
    "plan_id": { "type": "string", "minLength": 1 },
    "mission_id": { "type": ["string", "null"] },
    "created_at": { "type": "string", "minLength": 1 },
    "source_type": { "type": "string", "enum": ["voice_transcript", "pasted_doc", "fragment", "structured_brief"] },
    "input_excerpt": { "type": "string" },
    "what_it_does": {
      "type": "object",
      "properties": {
        "summary": { "type": "string" },
        "goals": { "type": "array", "items": { "type": "string" } },
        "user_stories": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["summary", "goals", "user_stories"],
      "additionalProperties": false
    },
    "how_it_looks": {
      "type": "object",
      "properties": {
        "description": { "type": "string" },
        "key_screens": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": { "name": { "type": "string", "minLength": 1 }, "description": { "type": "string" } },
            "required": ["name", "description"],
            "additionalProperties": false
          }
        },
        "design_references": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["description", "key_screens", "design_references"],
      "additionalProperties": false
    },
    "how_it_works": {
      "type": "object",
      "properties": {
        "description": { "type": "string" },
        "key_flows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "steps": { "type": "array", "items": { "type": "string" } }
            },
            "required": ["name", "steps"],
            "additionalProperties": false
          }
        },
        "integrations": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["description", "key_flows", "integrations"],
      "additionalProperties": false
    },
    "data_model": {
      "type": "object",
      "properties": {
        "entities": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "fields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string", "minLength": 1 },
                    "type": { "type": "string" },
                    "description": { "type": "string" }
                  },
                  "required": ["name", "type", "description"],
                  "additionalProperties": false
                }
              },
              "relationships": { "type": "array", "items": { "type": "string" } }
            },
            "required": ["name", "fields", "relationships"],
            "additionalProperties": false
          }
        }
      },
      "required": ["entities"],
      "additionalProperties": false
    },
    "non_goals": { "type": "array", "items": { "type": "string" } },
    "acceptance_criteria": { "type": "array", "items": { "type": "string" } },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "question": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "enum": ["ambiguity", "scope", "design", "technical", "data"] },
          "raised_from": { "type": "string" },
          "blocking": { "type": "boolean" },
          "status": { "type": "string", "enum": ["open", "resolved"] },
          "resolution": { "type": ["string", "null"] }
        },
        "required": ["id", "question", "category", "raised_from", "blocking", "status", "resolution"],
        "additionalProperties": false
      }
    },
    "routing_context": {
      "type": ["object", "null"],
      "properties": {
        "decision_id": { "type": ["string", "null"] },
        "mission_id": { "type": ["string", "null"] },
        "entry_command": { "type": ["string", "null"] },
        "orchestrator": { "type": ["string", "null"] },
        "outcome_type": {
          "type": ["string", "null"],
          "enum": ["decide", "design", "build", "convert", "recover", "govern", "review", "communicate", "scale", null]
        }
      },
      "required": ["decision_id", "mission_id", "entry_command", "orchestrator", "outcome_type"],
      "additionalProperties": false
    },
    "summary_for_approval": { "type": "string" },
    "open_question_count": { "type": "integer", "minimum": 0 },
    "resolved_connectors": {
      "type": "array",
      "description": "Connectors v1 (docs/design/connectors-architecture.md §6.2/§6.4): the PLAN-TIME resolution of how_it_works.integrations against the connector registry — one entry per integration, same order. Bound into content.plan_content_hash() alongside every other content dimension (PR #82's existing approval-gate mechanism; no new trust machinery). OPTIONAL (default []): a pre-Connectors-v1 persisted Plan JSON record predates this field entirely and must still validate — see spec_engine.types.Plan.resolved_connectors' own default_factory=list and content.plan_content_hash()'s additive-only hashing.",
      "items": {
        "type": "object",
        "properties": {
          "integration_name": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["resolved", "unresolved"] },
          "connector_id": { "type": ["string", "null"] },
          "connector_version": { "type": ["string", "null"] },
          "manifest_hash": { "type": ["string", "null"] },
          "display_name": { "type": ["string", "null"] },
          "base_url": { "type": ["string", "null"] },
          "base_url_override_env": { "type": ["string", "null"] },
          "api_version_pin_kind": { "type": ["string", "null"] },
          "api_version_pin_name": { "type": ["string", "null"] },
          "api_version_pin_value": { "type": ["string", "null"] },
          "auth_env_vars": { "type": "array", "items": { "type": "string" } },
          "auth_header_name": { "type": ["string", "null"] },
          "auth_header_value_prefix": { "type": "string" },
          "timeout_ms": { "type": ["integer", "null"] },
          "error_map": { "type": "object" },
          "operations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "side_effect": { "type": "string", "enum": ["read", "write", "spend"] },
                "http_method": { "type": "string", "minLength": 1 },
                "http_path": { "type": "string", "minLength": 1 }
              },
              "required": ["name", "side_effect", "http_method", "http_path"],
              "additionalProperties": false
            }
          },
          "registered_connector_ids": { "type": "array", "items": { "type": "string" } }
        },
        "required": [
          "integration_name", "status", "connector_id", "connector_version", "manifest_hash",
          "display_name", "base_url", "base_url_override_env", "api_version_pin_kind",
          "api_version_pin_name", "api_version_pin_value", "auth_env_vars", "auth_header_name",
          "auth_header_value_prefix", "timeout_ms", "error_map", "operations", "registered_connector_ids"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "plan_id", "mission_id", "created_at", "source_type", "input_excerpt",
    "what_it_does", "how_it_looks", "how_it_works", "data_model",
    "non_goals", "acceptance_criteria", "open_questions", "routing_context",
    "summary_for_approval", "open_question_count"
  ],
  "additionalProperties": false,
  "$comment": "Minimal-validator keyword subset supported by spec_engine.spec_check: type, enum, properties, required, additionalProperties, items."
}
