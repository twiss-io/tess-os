{
  "permissions": {
    "allow": [
      "Bash(git*)",
      "Bash(python3 scripts/brain/onboard.py:*)"
    ]
  },
  "autoMemoryEnabled": false,
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/utc-local-context.sh"
          },
          {
            "type": "command",
            "command": "sh -c 'f=\"$CLAUDE_PROJECT_DIR/scripts/brain/tessbrain.py\"; [ -f \"$f\" ] && command -v python3 >/dev/null 2>&1 && exec python3 \"$f\" hook prompt --runtime claude || exit 0'",
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__plugin_telegram_telegram__reply",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/telegram-format-guard.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/anti-fabrication-guard.sh"
          }
        ]
      },
      {
        "matcher": "mcp__plugin_telegram_telegram__edit_message",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/telegram-format-guard.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/anti-fabrication-guard.sh"
          }
        ]
      },
      {
        "matcher": "^(Task|Agent)$",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/task-lock-set.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/vault-dispatch-scan.py"
          }
        ]
      },
      {
        "matcher": "^(Bash|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"systemMessage\": \"Agent completed. If you are Tess: send a Telegram update to the operator NOW before continuing. Use mcp__plugin_telegram_telegram__reply.\"}'"
          }
        ]
      },
      {
        "matcher": "^(Task|Agent)$",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/task-lock-clear.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/task-lock-clear.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'f=\"$CLAUDE_PROJECT_DIR/scripts/brain/onboard.py\"; [ -f \"$f\" ] && command -v python3 >/dev/null 2>&1 && exec python3 \"$f\" hook session-start --runtime claude || exit 0'",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "sh -c 'f=\"$CLAUDE_PROJECT_DIR/scripts/brain/tessbrain.py\"; [ -f \"$f\" ] && command -v python3 >/dev/null 2>&1 && exec python3 \"$f\" hook session-start --runtime claude || exit 0'",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'f=\"$CLAUDE_PROJECT_DIR/scripts/brain/tessbrain.py\"; [ -f \"$f\" ] && command -v python3 >/dev/null 2>&1 && exec python3 \"$f\" hook stop --runtime claude || exit 0'",
            "async": true,
            "timeout": 30
          }
        ]
      }
    ]
  }
}
