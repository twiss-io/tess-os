{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch --list:*)",
      "Bash(python3 scripts/brain/onboard.py:*)",
      "Bash(python3 scripts/brain/tessbrain.py recall:*)",
      "Bash(python3 scripts/brain/tessbrain.py status:*)",
      "Bash(python3 scripts/brain/tessbrain.py review:*)",
      "Bash(python3 scripts/brain/tessbrain.py decide:*)",
      "Bash(python3 scripts/brain/tessbrain.py remember:*)"
    ]
  },
  "autoMemoryEnabled": true,
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/run-pinned.py\" --on-fail warn -- .claude/hooks/utc-local-context.sh"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/run-pinned.py\" --on-fail warn --closure scripts/brain -- scripts/brain/tessbrain.py hook prompt --runtime claude",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Task|Agent)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/run-pinned.py\" --on-fail warn -- .claude/hooks/task-lock-set.sh"
          },
          {
            "type": "command",
            "command": "command -v python3 >/dev/null 2>&1 || { echo \"TESS HOOK NOT RUN: python3 was not found, so the dispatch secret scan cannot run; this dispatch is blocked.\" >&2; exit 2; }; exec python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/run-pinned.py\" --on-fail block -- .claude/hooks/vault-dispatch-scan.py"
          }
        ]
      },
      {
        "matcher": "^(Bash|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/run-pinned.py\" --on-fail warn -- .claude/hooks/dispatch-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Task|Agent)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/run-pinned.py\" --on-fail warn -- .claude/hooks/task-lock-clear.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/run-pinned.py\" --on-fail warn --closure scripts/brain -- scripts/brain/tessbrain.py hook stop --runtime claude",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/run-pinned.py\" --on-fail warn -- .claude/hooks/task-lock-clear.sh"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/run-pinned.py\" --on-fail warn --closure scripts/brain -- scripts/brain/tessbrain.py hook stop --runtime claude",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/run-pinned.py\" --on-fail warn --closure scripts/brain -- scripts/brain/onboard.py hook session-start --runtime claude",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/run-pinned.py\" --on-fail warn --closure scripts/brain -- scripts/brain/tessbrain.py hook session-start --runtime claude",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
