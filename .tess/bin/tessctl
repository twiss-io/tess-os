import tempfile
import time
import uuid
from pathlib import Path

try:
    import fcntl
except ImportError:  # pragma: no cover — POSIX-only (Linux/macOS CI + darwin dev);
    # mirrors this file's existing sys.platform == "darwin" branches elsewhere:
    # a feature that is inherently platform-scoped degrades explicitly rather
    # than crashing at import time. Task/ledger locking (TASK LEDGER region)
    # is a no-op best-effort skip when fcntl is unavailable, not a silent
    # correctness gap on the platforms this repo actually ships/tests on.
    fcntl = None

try:
    import yaml
except ImportError:
    sys.exit("tessctl requires pyyaml: pip install pyyaml")


class GateError(Exception):
    """Raised by check_manifest_write_gate on any write-gate violation.

    Replaces sys.exit() so that BULK callers (_do_restore, _apply_per_file_resolution,
    cmd_publish (--tag), cmd_capture (scan/--all)) can catch per-iteration and
    skip-with-warning rather than aborting the entire run.
    Single-file command entrypoints let the exception propagate to main(), where it is
    converted to sys.exit(str(e)) to preserve identical UX/exit-code behavior.
    """


