             "end-to-end (gate check -> dispatch -> verify -> typed retry -> halt/escalate)",
    )
    p_run.add_argument("crew_plan", metavar="CREW-PLAN",
                        help="path to a crew-plan.schema.json instance (.json/.yaml/.md)")
    p_run.add_argument(
        "--driver", choices=sorted(RUN_DRIVERS), default="claude",
        help="dispatch driver: claude (claude -p, Tier A) | codex (codex exec, Tier B) | "
             "fake (deterministic, tests/dry-runs only)",
    )
    p_run.add_argument("--timeout", type=float, metavar="SECONDS",
                        help="per-dispatch subprocess timeout in seconds (default: 600)")
    p_run.add_argument("--fake-script", dest="fake_script", metavar="PATH",
                        help="(--driver fake only) JSON file scripting FakeDriver's per-task responses")
    p_run.add_argument("--by", help="override the recorded actor for retry/escalation records (default: current OS user)")
    p_run.add_argument("--json", action="store_true", dest="json_out", help="machine-readable JSON output")

    # tasks — Phase 0.2: the cross-harness TASK STORE (TASK LEDGER region,
    # directly below the RUN region — a sibling of `mission`/`retry` above).
    # Phase 0.4 (issue #125) added the LANE (`--lane` on new/set/pull) and
    # `handoff`; Phase 0.5 (issue #129) added `block` (the structured
    # stuck-packet) — see each subcommand's own help/docstring below.
    p_tasks = sub.add_parser(
        "tasks",
        help="cross-harness task store: file-per-task JSON under .tess/state/tasks/ "
             "(new | set | claim | release | block | pull | render | handoff)",
    )
    tasks_sub = p_tasks.add_subparsers(dest="tasks_sub", metavar="SUBCOMMAND")

    p_tasks_new = tasks_sub.add_parser("new", help="create a new task")
    p_tasks_new.add_argument("title", help="human-readable task title")
    p_tasks_new.add_argument("--status", choices=list(TASK_STATUSES), help="initial status (default: backlog)")
    p_tasks_new.add_argument("--owner", help="human/team owner")
    p_tasks_new.add_argument("--assignee", help="agent/persona currently assigned")
    p_tasks_new.add_argument(
        "--depends-on", dest="depends_on", metavar="ID[,ID...]",
        help="comma-separated task ids this task depends on",
    )
    p_tasks_new.add_argument(
        "--harness", required=True,
        help="the harness creating this task (e.g. claude-code, codex) — recorded in "
             "created_by AND as the ledger actor for the implicit creation event",
    )
    p_tasks_new.add_argument(
        "--lane", choices=list(TASK_LANES),
        help=f"earmark this task's routing lane — which harness SHOULD pick it up "
             f"(distinct from --harness above, the CREATOR's identity). Default: "
             f"{DEFAULT_TASK_LANE!r} (eligible for every harness — omitting --lane "
             f"is byte-for-byte the pre-lane behavior). `tessctl tasks pull --lane "
             f"<harness>` filters to a task's own lane plus any {DEFAULT_TASK_LANE!r} "
             f"task.",
    )
    p_tasks_new.add_argument("--session", help="harness session id (optional)")
    p_tasks_new.add_argument("--json", action="store_true", dest="json_out")

    p_tasks_set = tasks_sub.add_parser("set", help="mutate an existing task (optimistic-concurrency CAS write)")
    p_tasks_set.add_argument("task_id", metavar="ID")
    p_tasks_set.add_argument("--status", choices=list(TASK_STATUSES))
    p_tasks_set.add_argument("--owner", help="pass '' to clear")
    p_tasks_set.add_argument("--assignee", help="pass '' to clear")
    p_tasks_set.add_argument(
        "--lane", choices=list(TASK_LANES),
        help="re-earmark this task's routing lane (see `tasks new --lane`'s own help); "
             "logged as a distinct `earmarked` ledger event when it is the ONLY change "
             "this call makes, `task_transition` otherwise",
    )
    p_tasks_set.add_argument("--add-depends", dest="add_depends", action="append", metavar="ID")
    p_tasks_set.add_argument("--add-evidence", dest="add_evidence", action="append", metavar="PATH")
    p_tasks_set.add_argument("--add-note", dest="add_note", metavar="TEXT")
    p_tasks_set.add_argument(
        "--heartbeat", action="store_true",
        help="refresh claim.heartbeat_at without changing anything else about the claim "
             "(refuses if the task is not currently claimed). SECURITY (Reid HIGH, PR "
             "#113 review): requires --host/--pid/--uuid matching the CURRENT claim — "
             "refused as TASK_NOT_CLAIMANT otherwise (or pass --force) — a heartbeat "
             "with no identity check would let anyone with the task id forge liveness "
             "for a claim they never hold, defeating --stale-after reclaim.",
    )
    p_tasks_set.add_argument(
        "--host", help="claimant host — required to --heartbeat unless --force (Reid HIGH)",
    )
    p_tasks_set.add_argument(
        "--pid", type=int, help="claimant pid — required to --heartbeat unless --force (Reid HIGH)",
    )
    p_tasks_set.add_argument(
        "--uuid", dest="claim_uuid",
        help="claimant instance uuid — required to --heartbeat unless --force (Reid HIGH)",
    )
    p_tasks_set.add_argument(
        "--force", action="store_true",
        help="--heartbeat only: refresh the heartbeat even if --host/--pid/--uuid do not "
             "match (or are omitted) — bypasses the TASK_NOT_CLAIMANT refusal",
    )
    p_tasks_set.add_argument(
        "--expected-rev", dest="expected_rev", type=int, metavar="N",
        help="CAS precondition: refuse with TASK_CAS_CONFLICT (no mutation) if the "
             "on-disk rev is not exactly N — reload and retry on conflict",
    )
    p_tasks_set.add_argument("--harness", required=True)
    p_tasks_set.add_argument("--session")
    p_tasks_set.add_argument("--by", help="who/what is recorded as the note author (default: OS user)")
    p_tasks_set.add_argument("--json", action="store_true", dest="json_out")

    p_tasks_claim = tasks_sub.add_parser("claim", help="claim a task (claim-lease + heartbeat)")
    p_tasks_claim.add_argument("task_id", metavar="ID")
    p_tasks_claim.add_argument("--host", required=True)
    p_tasks_claim.add_argument("--pid", required=True, type=int)
    p_tasks_claim.add_argument(
        "--uuid", dest="claim_uuid",
        help="claimant instance uuid (default: a STABLE uuid5 derived from --host+--pid — "
             "so a re-claim by the SAME process, with no explicit --uuid, is recognized as "
             "the same claimant/a clean heartbeat, not a stranger stealing the claim; Reid "
             "MEDIUM, PR #113 review — pass an explicit value only if you need finer "
             "disambiguation than host+pid alone provides)",
    )
    p_tasks_claim.add_argument("--harness", required=True)
    p_tasks_claim.add_argument("--session")
    p_tasks_claim.add_argument("--persona")
    p_tasks_claim.add_argument(
        "--stale-after", dest="stale_after", type=int, metavar="SECONDS",
        help=f"seconds of quiet heartbeat before an existing claim by a DIFFERENT "
             f"claimant is treated as abandoned (default: {DEFAULT_CLAIM_STALE_SECONDS})",
    )
    p_tasks_claim.add_argument("--force", action="store_true", help="steal a live (non-stale) claim anyway")
    p_tasks_claim.add_argument("--json", action="store_true", dest="json_out")

    p_tasks_release = tasks_sub.add_parser("release", help="release a claimed task")
    p_tasks_release.add_argument("task_id", metavar="ID")
    p_tasks_release.add_argument("--host", required=True)
    p_tasks_release.add_argument("--pid", required=True, type=int)
    p_tasks_release.add_argument("--uuid", dest="claim_uuid", required=True)
    p_tasks_release.add_argument(
        "--status", choices=list(TASK_STATUSES), help="status to set on release (default: unchanged)",
    )
    p_tasks_release.add_argument(
        "--reason", choices=["completed", "crashed", "released"],
        help="ledger event classification (default: released)",
    )
    p_tasks_release.add_argument("--harness", required=True)
    p_tasks_release.add_argument("--session")
    p_tasks_release.add_argument(
        "--force", action="store_true", help="release even if the claim belongs to a different host/pid/uuid",
    )
    p_tasks_release.add_argument("--json", action="store_true", dest="json_out")

    # Phase 0.5 (issue #129): `block` — the STRUCTURED STUCK-PACKET. Sets
    # status to `blocked` (like `set --status blocked` already could) AND
    # records the structured context a resuming agent needs — distinct from
    # the bare status transition, which stays exactly as it was.
    p_tasks_block = tasks_sub.add_parser(
        "block",
        help="mark a task blocked/stuck AND record a structured, resumable-by-any-agent packet "
             "(what blocked it, progress so far, what was tried, what's needed)",
    )
    p_tasks_block.add_argument("task_id", metavar="ID")
    p_tasks_block.add_argument(
        "--reason", required=True, choices=list(TASK_BLOCK_REASONS),
        help="why this task stopped — required_input | failed_dependency | gate | "
             "decision_needed | other",
    )
    p_tasks_block.add_argument(
        "--summary", required=True, help="one-line statement of what blocked it",
    )
    p_tasks_block.add_argument(
        "--progress", required=True,
        help="last-known progress/state — what was accomplished before this stopped, and where",
    )
    p_tasks_block.add_argument(
        "--needed", required=True, help="what is needed to unblock this task",
    )
    p_tasks_block.add_argument(
        "--attempted", action="append", metavar="TEXT",
        help="something already tried that did not resolve the block (repeatable; optional)",
    )
    p_tasks_block.add_argument(
        "--harness", required=True, help="the harness recording this block (blocked_by.harness)",
    )
    p_tasks_block.add_argument("--session", help="harness session id (optional)")
    p_tasks_block.add_argument("--persona", help="named persona/agent recording the block, if relevant")
    p_tasks_block.add_argument("--json", action="store_true", dest="json_out")

    p_tasks_pull = tasks_sub.add_parser("pull", help="list tasks matching filters (read-only)")
    p_tasks_pull.add_argument("--status", choices=list(TASK_STATUSES), action="append")
    p_tasks_pull.add_argument("--owner")
    p_tasks_pull.add_argument("--unclaimed", action="store_true")
    p_tasks_pull.add_argument(
        "--lane", choices=list(TASK_LANES),
        help=f"only tasks earmarked for this harness, PLUS every task earmarked "
             f"{DEFAULT_TASK_LANE!r} (a worker's own lane pull: e.g. a Codex worker "
             f"runs `tasks pull --unclaimed --lane codex` to see its earmarked work "
             f"plus every unmarked task). Omitting --lane entirely (the default) "
             f"applies no lane filter at all — every existing `pull` invocation "
             f"keeps returning exactly what it always did.",
    )
    p_tasks_pull.add_argument("--limit", type=int)
    p_tasks_pull.add_argument("--json", action="store_true", dest="json_out")

    tasks_sub.add_parser("render", help="regenerate .tess/state/tasks/BOARD.md (derived kanban view)")

    # Phase 0.4 (issue #125): `handoff` — earmark + emit a copy-pasteable
    # invocation for an external worker harness. PREPARES a handoff; never
    # spawns a process of `--harness` (no such runtime available here).
    p_tasks_handoff = tasks_sub.add_parser(
        "handoff",
        help="prepare (not spawn) a handoff of a task to an external worker harness — "
             "earmarks its lane + prints a copy-pasteable invocation",
    )
    p_tasks_handoff.add_argument("task_id", metavar="ID")
    p_tasks_handoff.add_argument(
        "--harness", required=True, choices=list(TASK_HANDOFF_LANES),
        help="the harness to hand this task off to (codex or claude-code — 'any' is "
             "not a valid handoff target: a handoff is inherently addressed to ONE "
             "specific worker, never 'whoever'). Idempotent: earmarks target_harness "
             "to this value if it is not already set that way.",
    )
    p_tasks_handoff.add_argument(
        "--by-harness", dest="by_harness", metavar="HARNESS",
        help="which harness/process is PREPARING this handoff — the ledger actor "
             "recorded for the 'handoff' event (default: 'orchestrator')",
    )
    p_tasks_handoff.add_argument("--session", help="harness session id of the PREPARING side (optional)")
    p_tasks_handoff.add_argument("--persona", help="named persona/agent preparing the handoff, if relevant")
    p_tasks_handoff.add_argument("--json", action="store_true", dest="json_out")

    # log — Phase 0.2: the hash-chained ACCOUNTABILITY LEDGER (sibling region).
    p_log = sub.add_parser(
        "log",
        help="hash-chained accountability ledger under .tess/state/ledger/ (append | view | verify)",
    )
    log_sub = p_log.add_subparsers(dest="log_sub", metavar="SUBCOMMAND")

    p_log_append = log_sub.add_parser("append", help="append one hash-chained event to a ledger shard (unsigned — see docs/STATE_LAYER.md)")
    p_log_append.add_argument(
        "--origin", required=True,
        help="shard key (usually the harness/persona identifier) — "
             ".tess/state/ledger/<YYYY-MM>.<origin>.jsonl",
    )
    p_log_append.add_argument("--event", required=True, choices=list(LEDGER_EVENTS))
    p_log_append.add_argument("--summary", required=True)
    p_log_append.add_argument("--task", help="task id this event refers to")
    p_log_append.add_argument("--mission", help="mission id this event refers to")
    p_log_append.add_argument("--harness", help="actor harness (default: --origin)")
    p_log_append.add_argument("--model")
    p_log_append.add_argument("--session")
    p_log_append.add_argument("--persona")
    p_log_append.add_argument("--json", action="store_true", dest="json_out")

    p_log_view = log_sub.add_parser("view", help="read-only view across ledger shard(s), sorted by ts")
    p_log_view.add_argument("--origin")
    p_log_view.add_argument("--task")
    p_log_view.add_argument("--mission")
    p_log_view.add_argument("--since", help="ISO-8601 timestamp lower bound (string-compared)")
    p_log_view.add_argument("--json", action="store_true", dest="json_out")

    p_log_verify = log_sub.add_parser(
        "verify", help="walk each shard's hash chain; exit 1 if any is tampered/broken",
    )
    p_log_verify.add_argument("--origin")

    # audit — Goal I1: the exportable, independently-verifiable auditor pack
    # (AUDIT PACK region, a sibling of TASK LEDGER/`log` above).
    p_audit = sub.add_parser(
        "audit",
        help="exportable auditor pack: accountability ledger events + agent "
             "receipts for a scope, independently verifiable offline (export | verify)",
    )
    audit_sub = p_audit.add_subparsers(dest="audit_sub", metavar="SUBCOMMAND")

    p_audit_export = audit_sub.add_parser(
        "export",
        help="export the accountability record for a scope (--task | --since/--until | --all) "
             "as a self-contained pack (manifest.json + SUMMARY.md)",
    )
    p_audit_export.add_argument("--task", metavar="ID", help="scope: one task id's ledger events")
    p_audit_export.add_argument("--since", metavar="TS", help="scope: time-range lower bound (ISO-8601, inclusive)")
    p_audit_export.add_argument("--until", metavar="TS", help="scope: time-range upper bound (ISO-8601, inclusive)")
    p_audit_export.add_argument("--all", action="store_true", help="scope: every event in every ledger shard")
    p_audit_export.add_argument(
        "--origin", metavar="ORIGIN", help="restrict to one shard origin (combinable with any scope)",
    )
    p_audit_export.add_argument(
        "--receipt", action="append", dest="receipts", metavar="PATH",
        help="embed an already-signed Agent Receipt JSON file verbatim (repeatable). There is "
             "no on-disk receipt store in this repository today (docs/AGENT_RECEIPT_SPEC.md) — "
             "receipts are supplied explicitly by the caller.",
    )
    p_audit_export.add_argument("--out", required=True, metavar="DIR", help="output directory for the pack")
    p_audit_export.add_argument("--force", action="store_true", help="overwrite a non-empty --out directory")

    p_audit_verify = audit_sub.add_parser(
        "verify",
        help="re-check an exported pack's hash-chain + embedded-receipt content-hash integrity "
             "using ONLY the pack's own contents — no live .tess/state/ access",
    )
    p_audit_verify.add_argument(
        "pack", metavar="PACK", help="pack directory (containing manifest.json) or a manifest.json path directly",
    )
    p_audit_verify.add_argument("--json", action="store_true", dest="json_out")

    # skill — Issue #131: the SKILL DRAFT SCAFFOLD region (a sibling of
    # `audit` above): `from-task` scaffolds a DRAFT skill from one
    # completed task's real ledger trail.
    p_skill = sub.add_parser(
        "skill",
        help="demo-to-skill: scaffold a reusable DRAFT skill from a task's real ledger trail (from-task)",
    )
    skill_sub = p_skill.add_subparsers(dest="skill_sub", metavar="SUBCOMMAND")

    p_skill_from_task = skill_sub.add_parser(
        "from-task",
        help="scaffold a DRAFT SKILL.md (+ provenance.json) from one task's real ledger "
             "trail — human-reviewed before it is authoritative, never auto-activated",
    )
    p_skill_from_task.add_argument("task_id", metavar="ID")
    p_skill_from_task.add_argument(
        "--out", metavar="DIR",
        help=f"output directory (default: {SKILL_DRAFTS_DIR}/<slug>, derived from the task title)",
    )
    p_skill_from_task.add_argument("--force", action="store_true", help="overwrite a non-empty --out directory")
    p_skill_from_task.add_argument("--harness", required=True, help="acting harness (ledger actor)")
    p_skill_from_task.add_argument("--session")
    p_skill_from_task.add_argument("--persona")
    p_skill_from_task.add_argument("--json", action="store_true", dest="json_out")

    # memory — Phase 0.3: the cross-harness MEMORY LINK (MEMORY ADOPT region,
    # a sibling of `tasks`/`log` above).
    p_memory = sub.add_parser(
        "memory",
        help="cross-harness memory link: adopt a harness-private memory dir into "
             ".tess/state/memory/ (adopt)",
    )
    memory_sub = p_memory.add_subparsers(dest="memory_sub", metavar="SUBCOMMAND")

    p_memory_adopt = memory_sub.add_parser(
        "adopt",
        help="move a harness memory dir's contents into the canonical store and "
             "replace it with a symlink (dry-run by default for both adopt and "
             "--revert; pass --yes to mutate)",
    )
    p_memory_adopt.add_argument(
        "--harness",
        help=f"which harness's well-known memory path to default --from to, or which "
             f"harness's adopt manifest --revert targets (default when adopting: "
             f"{DEFAULT_MEMORY_ADOPT_HARNESS!r}; default when reverting: infer from the "
             f"single manifest present, or refuse if more than one)",
    )
    p_memory_adopt.add_argument(
        "--from", dest="from_dir", metavar="DIR",
        help="explicit source memory directory (overrides the --harness default when "
             "adopting; when reverting, overrides where content is restored TO — it is "
             "not used to locate the manifest, so it need not match the original adopt's "
             "--from)",
    )
    p_memory_adopt.add_argument(
        "--to", dest="to_dir", metavar="DIR",
        help=f"canonical store directory (default: {MEMORY_DIR})",
    )
    p_memory_adopt.add_argument(
        "--yes", action="store_true",
        help="perform the adopt, or the --revert, for real (default: dry-run, reports "
             "the plan only)",
    )
    p_memory_adopt.add_argument(
        "--merge", action="store_true",
        help="allow adopting into a non-empty canonical store",
    )
    p_memory_adopt.add_argument(
        "--revert", action="store_true",
        help="undo a previous adopt using its own recorded manifest (dry-run by "
             "default, same as adopt — pass --yes to perform it for real)",
    )
    p_memory_adopt.add_argument("--json", action="store_true", dest="json_out")

    # mcp (Goal #9) — the gate as an MCP server
    p_mcp = sub.add_parser(
        "mcp",
        help="Goal #9: MCP server — expose validate/gate/mission/roster as MCP tools over stdio",
    )
    mcp_sub = p_mcp.add_subparsers(dest="mcp_sub", metavar="SUBCOMMAND")
    mcp_sub.add_parser(
        "serve",
        help="run a stdio JSON-RPC 2.0 MCP server (initialize / tools/list / tools/call); see docs/MCP.md",
    )

    return parser


def main() -> None:
    parser = build_parser()
    args = parser.parse_args()

    if not args.command:
        parser.print_help()
        sys.exit(0)

    root = find_tess_root()

    # LOW fix: scope tool checks to what each command actually invokes.
    # The original blanket check demanded git+diff+patch for all SUBPROCESS_COMMANDS,
    # but e.g. capture only needs diff; update needs git+patch; resolve needs nothing
    # (--ours/--theirs do no subprocess; --edit invokes $EDITOR, not checked here).
    _TOOL_REQUIREMENTS: dict[str, list[str]] = {
        "update":      ["git", "patch", "gpg"],  # signed-tag fetch (git) + merge-file (git) + patch-apply (patch) + isolated GNUPGHOME (gpg)
        "self-update": ["git", "gpg"],           # signed-tag fetch + clone + isolated GNUPGHOME
        "capture":     ["diff"],           # diff -u for provenance log
        "diff":        ["git"],            # git diff --no-index
        "doctor":      ["diff"],           # doctor --fix calls diff -u (Reid LOW-1)
        "override":    ["diff"],           # diff -u to compute patch
        "approve":     ["diff"],           # diff -u for event log
        "publish":     ["git"],            # git diff --no-index (--force mode)
        "resolve":     [],                 # --ours/--theirs: no subprocess; --edit: $EDITOR
        "gate":        ["git", "gpg"],     # changed-path discovery (git) + covering-verdict signature verify (isolated GNUPGHOME, gpg)
        "verdict":     ["gpg"],            # sign (detach-sign) / verify (isolated GNUPGHOME)
    }
    tools_needed = _TOOL_REQUIREMENTS.get(args.command, [])
    if args.command == "verdict" and getattr(args, "verdict_sub", None) == "keygen":
        # This subcommand is a refusal-only compatibility surface. Check no
        # external tool first so every environment gets the same explicit
        # TRUST_BOOTSTRAP_REQUIRED state without invoking or requiring GPG.
        tools_needed = []
    if tools_needed:
        _check_tools(*tools_needed)

    dispatch = {
        "init":         cmd_init,
        "restore":      cmd_restore,
        "doctor":       cmd_doctor,
        "update":       cmd_update,
        "self-update":  cmd_self_update,
        "publish":      cmd_publish,
        "override":     cmd_override,
        "capture":      cmd_capture,
        "rollback":     cmd_rollback,
        "diff":         cmd_diff,
        "render":       cmd_render,
        "verify":       cmd_verify,
        "approve":      cmd_approve,
        "resolve":      cmd_resolve,
        "reset":        cmd_reset,
        "lock":         cmd_lock,
        # M2: curated-squad mechanism
        "roster":       cmd_roster,
        "recruit":      cmd_recruit,
        "bench":        cmd_bench,
        # M4/M6: persona + name render layer
        "identity":     cmd_identity,
        "rename":       cmd_rename,
        "set-operator": cmd_set_operator,
        "pathway":      cmd_pathway,
        # M5: vault — age-encrypted secret store
        "vault":        cmd_vault,
        # Phase 0: contracts-as-code validator
        "validate":     cmd_validate,
        # Phase 2b: verdict signing key management
        "verdict":      cmd_verdict,
        # Phase 2: deterministic gate spine (Decisions #2/#6)
        "gate":         cmd_gate,
        # Goal #8: mission trace log + OTel GenAI export
        "trace":        cmd_trace,
        # Goal #5: mission ledger — mission records as code (MISSION LEDGER
        # region, above cmd_gate()). "gate clear" itself dispatches through
        # "gate" -> cmd_gate() -> its own handlers dict, not a top-level key here.
        "mission":      cmd_mission,
        "gate-status":  cmd_gate_status,
        "retry":        cmd_retry,
        # Goal #6: `tessctl run` — the mechanical conductor loop (RUN region,
        # directly below the MISSION LEDGER region).
        "run":          cmd_run,
        # Goal #9: `tessctl mcp serve` — the gate as an MCP server (MCP
        # region, directly below the RUN region).
        "mcp":          cmd_mcp,
        # Phase 0.2: the cross-harness TASK STORE + ACCOUNTABILITY LEDGER
        # (TASK LEDGER region, directly below the RUN region — a sibling of
        # the MISSION LEDGER region above).
        "tasks":        cmd_tasks,
        "log":          cmd_log,
        # Goal I1: the exportable, independently-verifiable auditor pack
        # (AUDIT PACK region, a sibling of TASK LEDGER/`log` above).
        "audit":        cmd_audit,
        # Issue #131: demo-to-skill — the SKILL DRAFT SCAFFOLD region, a
        # sibling of AUDIT PACK above.
        "skill":        cmd_skill,
        # Phase 0.3: the cross-harness MEMORY LINK (MEMORY ADOPT region, a
        # sibling of TASK LEDGER above).
        "memory":       cmd_memory,
    }

    fn = dispatch.get(args.command)
    if not fn:
        sys.exit(f"tessctl: unknown command: {args.command}")

    # GateError propagated out of single-file command entrypoints (cmd_publish
    # single-target, cmd_override, cmd_approve, cmd_reset, cmd_resolve,
    # _do_render, etc.) is caught here and converted to sys.exit(str(e)),
    # preserving the exact UX and exit-code behavior that sys.exit() in
    # check_manifest_write_gate produced before we switched to raising GateError.
    # Bulk callers (_do_restore, _apply_per_file_resolution, cmd_publish --tag,
    # cmd_capture scan/--all) catch GateError per-iteration before it reaches
    # here, so this handler only fires for genuinely single-target violations.
    # MissionError (Goal #5, MISSION LEDGER region) is caught the same way —
    # every cmd_mission/cmd_gate_status/cmd_retry/_cmd_gate_clear entrypoint
    # already catches it locally too; this is the defense-in-depth backstop.
    # RunError (Goal #6, RUN region) mirrors the same pattern — cmd_run
    # already catches it locally too; this is the defense-in-depth backstop.
    # TaskError/LedgerError (Phase 0.2, TASK LEDGER region) mirror the same
    # pattern again — every cmd_tasks_*/cmd_log_* entrypoint already catches
    # them locally too; this is the defense-in-depth backstop.
    # MemoryAdoptError (Phase 0.3, MEMORY ADOPT region) mirrors the same
    # pattern again — _cmd_memory_adopt already catches it locally too;
    # this is the defense-in-depth backstop.
    # SkillError (Issue #131, SKILL DRAFT SCAFFOLD region) mirrors the same
    # pattern again — _cmd_skill_from_task already catches it locally too;
    # this is the defense-in-depth backstop.
    try:
        fn(args, root)
    except (
        GateError, MissionError, RunError, TaskError, LedgerError,
        MemoryAdoptError, AuditError, SkillError,
    ) as e:
        sys.exit(str(e))


if __name__ == "__main__":
    main()
