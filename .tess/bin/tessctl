                    "items": {"type": "string"},
                    "description": "Restrict covering-verdict discovery to these directories (default: whole tree).",
                },
            },
            "required": ["paths", "base"],
        },
        "fn": _mcp_tool_gate_check_paths,
    },
    "mission_status": {
        "description": (
