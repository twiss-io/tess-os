# Phase 2 — where the ship-gate's policy INSTANCE (not the schema) lives.
# Distinct from CONTRACTS_DIR (which holds the schema, policy.schema.json).
POLICY_DIR = "core/policy"
POLICY_INSTANCE_CANDIDATES = ("policy.yaml", "policy.yml", "policy.json")

# Phase 2 — where a human operator's explicit hard-floor sign-off artifacts
# live (guardrails.md Rule 18: credentials/money/destructive-prod-data/
# client-external-claims are NEVER satisfiable by a verifier's verdict alone).
GATE_SIGNOFF_DIR = ".tess/gate/signoffs"

# PR-2 (Agent Receipt EMIT wiring, tools/receipt-emit/) — where the ship-gate
# auto-appends one Agent Receipt per governed decision it accepts as
# clearing a rule. A SIXTH `.tess/state/**` subsystem (memory/tasks/ledger/
# locks/skills already exist — docs/STATE_LAYER.md), NOT a sibling
# `.tess/receipts/**`: this is auto-generated, machine-local, high-frequency
# evidence produced on every gate run (much closer in kind to
# `.tess/state/ledger/**`'s own hash-chained append log than to a
# deliberately-authored, committed artifact like a verdict or sign-off), so
# it inherits the EXISTING `.tess/state/**` umbrella fence — tess.manifest.json
# never_touch and `_PUBLISH_CLEAN_PRIVATE_GLOBS` already cover
# `.tess/state/**` as a whole, for free, with zero new glob entries needed
# here. Only the two PER-SUBSYSTEM additions #111 and #132 each already made
# when extending this same fence are needed for THIS subsystem too: a
# content-level `.gitignore` entry (`.tess/state/receipts/*` +
# `!.tess/state/receipts/.gitkeep`) and a `create-tess/src/ignore.js`
# `EXCLUDE_CONTENT_PREFIXES` entry — both added alongside this constant. A
# receipt's own evidentiary value (GPG signature + hash chain,
# `tools/receipt-verify/receipt_verify.py verify-chain`) is a property of the
# FILE, independent of git-tracking status — same operating model as
# `.tess/state/ledger/**`, verified via `tessctl log verify` with no git
# involvement at all. Persisting a CI runner's locally-emitted receipts back
# into the remote repo's git history (an authenticated commit-back step) is
# a deliberate, disclosed, OUT-OF-SCOPE follow-on for this PR — see
# docs/AGENT_RECEIPT_SPEC.md and this PR's own description; auto-committing
# from CI is a separate, later, explicitly-authorized design decision, not
# something this wiring silently assumes.
GATE_RECEIPT_CHAIN_REL = ".tess/state/receipts/chain.jsonl"

# ★ SECURITY (Reid CRITICAL, PR #137 review, honesty-capstone-audit-2026-07-08
# §3-c — "same-push TOOLING tamper", the same class already fixed once for
# the engine itself): `tools/receipt-emit/receipt_emit.py` and, transitively,
# `tools/receipt-verify/*.py` are EXECUTED BY THE GATE as a subprocess. They
# are NOT extracted from the trusted BASE ref by
# `.github/workflows/tess-gate.yml`'s own "Extract trusted gate engine" step
# (which pins ONLY `.tess/bin/tessctl` itself) and are not (yet) covered by
# `tess-os-security-tier-doctrine`'s policy globs or `tess.lock` tracking —
# so resolving these files against `root` (the PUSHED/candidate tree; on CI,
# `TESS_ROOT=github.workspace`; on `pre-push`, the developer's own local
# working tree) would let a single push smuggle a MODIFIED `receipt_emit.py`
# alongside an unrelated, otherwise-legitimately-cleared rule — the
# "trusted" (base-ref-pinned) engine would then auto-execute that modified
# code, on CI, or worse on a maintainer's own machine with their LIVE GPG
# signing keyring during `pre-push`. `RECEIPT_EMIT_CLI_REL`/
# `RECEIPT_VERIFY_TOOLS_REL` below are therefore never joined directly onto
# `root` — see `_gate_extract_trusted_receipt_tooling`, which mirrors the CI
# workflow's own "extract from BASE ref, fail closed if unavailable, never
# fall back to the pushed tree" discipline for exactly these ten files, the
# ONLY point in this module that resolves them onto an actual filesystem
# path an interpreter is asked to load.
RECEIPT_EMIT_CLI_REL = "tools/receipt-emit/receipt_emit.py"

# The full trust closure `receipt_emit.py` needs to run (imports, verified by
# reading each file's own `import`/`from` statements) — `tools/receipt-emit/`
# (its own package) plus `tools/receipt-verify/` (reused, never duplicated,
# per that tool's own README) it imports directly AND separately re-invokes
# as its own self-verify subprocess. Every one of these ten files, and ONLY
# these ten, is extracted from the trusted BASE ref — nothing else under
# `tools/**` (a README, `__pycache__`, a future unrelated file) is needed at
# runtime, so nothing else is trusted or copied.
RECEIPT_TOOL_TRUST_CLOSURE = (
    ("tools/receipt-emit", "receipt_emit.py"),
    ("tools/receipt-emit", "assemble.py"),
    ("tools/receipt-emit", "chain_atomic.py"),
    ("tools/receipt-emit", "errors.py"),
    ("tools/receipt-emit", "gpg_sign.py"),
    ("tools/receipt-emit", "policy_lookup.py"),
    ("tools/receipt-verify", "receipt_verify.py"),
    ("tools/receipt-verify", "canonical.py"),
    ("tools/receipt-verify", "checks.py"),
    ("tools/receipt-verify", "gpg_verify.py"),
)

# PR-2 (Agent Receipt EMIT wiring) — printed once whenever `tessctl gate
# pre-push|ci` auto-emits at least one receipt, deliberately in the SAME
# spirit as `tools/receipt-emit/receipt_emit.py`'s own HONEST_LABEL constant
# (never imported directly — this process never imports that tool's Python
# module, only invokes its CLI as a subprocess — kept in matching wording by
# hand instead). Gate wiring does NOT change what a receipt proves: a gate
# PASS plus a minted receipt means this decision was validly, genuinely
# signed — it does NOT mean the gate is running under an enforced,
# trust-anchored key registry. Do not let 'the gate emitted a receipt' read
# as 'the gate is enforced/trusted.'
GATE_RECEIPT_HONEST_NOTE = (
    "  NOTE: every receipt above is genuinely GPG-signed and tamper/chain-evident, but is NOT\n"
    "  trust-anchored until the signer's key is registered in core/policy/policy.yaml. A gate\n"
    "  PASS plus a minted receipt means this specific decision was validly, genuinely signed —\n"
    "  it does NOT by itself mean the gate is running under an enforced, trust-anchored registry."
)

# verification-routing.md's six named mandatory verifiers — verbatim as the
# `verdict.verifier` / `policy.rules[].allowed_verifiers` schema enum. Phase
# 2b's `policy.verifier_keys` map is keyed by these SAME names, but a plain
# JSON Schema object node cannot itself restrict its own property NAMES to a
# fixed enum (only VALUES) — so `_lint_policy` enforces this relationally,
# the same "schema can't express it, lint does" pattern already used for
# rule-id uniqueness.
VERIFIER_NAMES = ("Reid", "Quinn", "Cyra", "Verity", "Maialen", "Lysandra")

LOCK_HEADER = """\
# tess.lock — Tess OS framework merge base of record.
# COMMITTED. Per spec kb/wiki/synthesis/2026-06-27-keystone-architecture.md sec.4.
# base_sha = sha256 of the PRISTINE .tess/core/<file> bytes at the pinned version.
# This file is the reproducibility guarantee; `tessctl verify` is the CI integrity gate
# (also available as `tessctl lock --check` for a strict CI-only non-zero-on-drift verb).
# MAINTAINER re-baseline: `tessctl lock --regen --yes` re-pins every base_sha to the
# CURRENT .tess/core bytes. Use ONLY after a deliberate, reviewed change to core (e.g. a
# de-identification scrub); it blesses whatever core is now as pristine.
"""

SECURITY_TIER_PATHS = {
    "conductor/guardrails.md",
    "conductor/verification-routing.md",
    "conductor/channel-guardrails.md",
    "conductor/dispatch-brief.md",
}

# R2 / HIGH-1: live paths whose content is generated by `tessctl render` (not
# hand-edited). When doctor detects drift on these paths the correct remedy is
# `tessctl render` (re-sync from operator-state), NEVER `tessctl capture`
# (which would launder a stale render as a deliberate local modification).
#
# HIGH-1 (Fable Phase-1 review): this used to be a Claude-only frozenset —
# only `cmd_render` consulted the `RENDER_TARGETS` registry; this classification
# set did not, so a Phase-2+ target's generated artifacts would be silently
# mis-routed to "run `tessctl capture`" (which QUARANTINEs/locally-modifies a
# stale render instead of re-rendering it). It is now DERIVED from the
# registry — see `render_generated_live_paths()` below the RENDER_TARGETS
# registry — as the union of every ENABLED target's `render_generated_paths()`.
# A frozenset constant can no longer express this (enablement is per-install,
# read from tess.manifest.json — see MED-3 / `enabled_render_targets()`), so
# every call site below now calls `render_generated_live_paths(root)` instead
# of referencing a module-level constant.

# ---------------------------------------------------------------------------
# Single security-tier predicate — canonical source of truth (§6 + defect #8)
# ---------------------------------------------------------------------------

def is_security_tier(core_key: str, attrs: dict) -> bool:
    """
    ONE predicate for security-tier determination. Used by capture, doctor,
    verify, restore, and the write gate.  Priority:
      1. tess.lock tier: security field (authoritative when set)
      2. SECURITY_TIER_PATHS fallback (handles files whose lock entry pre-dates
         the tier field, and dispatch-brief.md which is security by doctrine).
    """
    if attrs.get("tier") == "security":
        return True
    live_rel = attrs.get("live_path", "")
    if live_rel in SECURITY_TIER_PATHS:
        return True
    # Also match by core_key (e.g. .tess/core/conductor/dispatch-brief.md)
    for p in SECURITY_TIER_PATHS:
        if core_key.endswith("/" + p) or core_key == p:
            return True
    return False


# Token → file mapping for CLAUDE.md template rendering
CLAUDE_TOKEN_MAP = {
    "{{CORE_RULE_ZERO}}":       ".tess/core/templates/claude-md/rule-zero.md",
    "{{CORE_SYSTEM_LAWS}}":     ".tess/core/templates/claude-md/system-laws.md",
    "{{CORE_HARD_FLOOR}}":      ".tess/core/templates/claude-md/hard-floor.md",
    "{{CORE_ORCHESTRATORS}}":   ".tess/core/templates/claude-md/orchestrators.md",
    "{{CORE_COMMANDS}}":        ".tess/core/templates/claude-md/commands.md",
    "{{CORE_DIRECTORY}}":       ".tess/core/templates/claude-md/directory.md",
}

# Token → file mapping for AGENTS.md template rendering (Phase 2 — Codex +
# generic render targets; RE-SCOPED 2026-07-08 to the WORKER doctrine profile
# — G3 / the 2026-07-07 honest reckoning, see RenderTarget.doctrine_profile
# below). AGENTS.md is the ONLY render (today) whose targets are all
# worker-profile, so its whole token map changed shape, not just its values:
#
#   - {{WORKER_HARD_FLOOR}} / {{WORKER_GATE_COMPLIANCE}} are WORKER-ONLY
#     fragments with NO CLAUDE.md equivalent — the orchestrator's own
#     `claude-md/hard-floor.md` bundles the hard floor together with
#     dependency gates, verification routing, and the retry protocol (all
#     orchestration ceremony that presumes a dispatchable crew). The two
#     fragments below carry ONLY the ~5-line hard floor and the gate's
#     compliance facts — see their own file headers for why nothing else is
#     added: per the reckoning, no doctrine payload has ever measured as
#     HELPING a single-agent harness, so nothing here ships on a
#     performance bet, only facts (the gate exists; don't touch its files)
#     and a safety floor (unmeasured on purpose, kept for consequence).
#   - {{HARNESS_NOTE}} documents the `.codex/prompts/**` / `prompts/**`
#     command-body mirrors (unchanged — a fact about what's on disk, not
#     doctrine).
#   - {{WORKER_SESSION_MEMORY}} (Phase 0.3, docs/STATE_LAYER.md) points a
#     worker harness at the ONE cross-harness memory store
#     (.tess/state/memory/) every harness mounts — a repo/state fact, same
#     category as the other two fragments, not orchestration doctrine (no
#     dispatch mechanics, no crew, nothing from WORKER_DOCTRINE_DENYLIST).
#     Claude Code needs no equivalent pointer: its own harness already
#     auto-reads its memory index natively; this fragment exists because
#     Codex/generic harnesses have no such native behavior and must be told
#     where the shared index lives.
#   - {{WORKER_SHARED_TASKS}} (issue #118, docs/STATE_LAYER.md) is
#     {{WORKER_SESSION_MEMORY}}'s sibling for the OTHER half of the shared
#     brain: the cross-harness task board at `.tess/state/tasks/` (Phase 0.2,
#     `tessctl tasks`/`tessctl log`). Same category as every fragment above —
#     a repo/CLI fact ("here is the shared board, here is how to see/claim/
#     update a task, claim with your own identity first"), never a dispatch
#     instruction: it tells a worker how to participate in an EXISTING task
#     board, not how to create/route/hand off work to another agent (no
#     phrase from WORKER_DOCTRINE_DENYLIST). Without this pointer a Codex
#     session has no doctrine-level way to discover it can see or claim work
#     from the same board a Claude Code session already reads/writes.
#
# Deliberately DROPPED versus the pre-G3 map (see the harm this fixes in
# AGENTS.md.tpl's own doctrine-drop banner + tests/test_worker_profile_denylist.py):
# CORE_RULE_ZERO, CORE_SYSTEM_LAWS, CORE_ORCHESTRATORS, CORE_DIRECTORY,
# CORE_COMMANDS/the 26-command table — CORE_RULE_ZERO/CORE_SYSTEM_LAWS/
# CORE_ORCHESTRATORS/the command table name or assume dispatch mechanics
# (the Agent tool, `.claude/agents/`, six outcome orchestrators, mode-switch
# slash commands) that do not hold for a single-agent harness, and are
# exactly the payload the 2026-07-07 proving-ground benchmark measured as
# harmful (a weak model attempted a nested subagent spawn on a bare
# `python3 --version` task under this exact doctrine). CORE_DIRECTORY is
# dropped for a different reason — not harmful, just heavy (~45 lines) —
# to keep this always-mounted digest inside its ~40-60 line budget; the
# repo's own README (or {{OPERATOR_BUILD_FACTS}} below) is the right place
# for layout facts a worker harness actually needs. `.codex/prompts/*.md` /
# `prompts/*.md` still mirror every command body verbatim (unchanged — see
