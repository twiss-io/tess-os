#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
# Copyright 2026 Twiss
"""
tessctl — Tess OS keystone CLI
Spec: kb/wiki/synthesis/2026-06-27-keystone-architecture.md §§3-5
Runtime: Python 3 (stdlib + pyyaml). No Node. Self-contained single file.

Implemented commands (Phase 1 + Phase 2 core + security hardening):
  init        scaffold operator/ stubs, run restore + render
  restore     re-sync live tree from .tess/core at locked version (no network, idempotent)
  doctor      SHA-integrity check every core-managed file; flag security-tier drift + core tamper
  update      snapshot → doctor gate → git subtree pull → per-file resolution → render → re-pin
  publish     copy core→live, status→user-published, stamp @published-from
  override    record diff vs core as patch-override in tess.lock
  capture     hash-detect in-place edit → locally-modified (security-tier → quarantined)
  rollback    restore from .tess/snapshots/<ts> + rewrite tess.lock
  diff        show core (rendered) vs live via git diff
  render      render CLAUDE.md from CLAUDE.md.tpl + operator/ stubs; render settings.json
  verify      core-integrity audit: .tess/core bytes vs base_sha + security-tier tampering check
  approve     accept a quarantined security-tier edit (the operator gate, rationale hard-required)
  resolve     resolve a conflict file: --ours / --theirs / --edit (open $EDITOR)
  validate    Phase 0 contracts-as-code: check a brief/crew-plan/verdict/return-manifest
              instance against core/contracts/*.schema.json; schema-miss classifies
              degraded_output per subagent-failure-protocol.md (see core/contracts/README.md)
  verdict     Phase 2b: `keygen` is deliberately disabled: verifier bootstrap is
              user-present custody work, never candidate-repository automation;
              `sign` a verdict's canonical content with a verifier's existing GPG key;
              `verify` a signed verdict against core/policy/policy.yaml's verifier_keys
  gate        Phase 2 (+2b): deterministic enforcement spine — pre-commit/pre-push/ci
              contract + covering-verdict + signature checks; install-hooks scaffolds the
              git hooks and the CI workflow (now push/pull_request-triggered, not just
              workflow_dispatch); `clear` (Goal #5) clears a mission gate — refuses
              without a real, on-disk --evidence artifact
  trace       Goal #8: local-first mission trace log — every `gate`/`validate`
              invocation appends a schema-valid JSONL event to
              missions/mission-<opaque-id>/trace.jsonl
              (or a per-run fallback under .tess/trace/runs/ when no mission id is
              inferable). `trace export --format otlp-json` maps the JSONL to OTel GenAI
              semantic-convention agent spans (OTLP/JSON) for ingestion by any APM that
              understands gen_ai.* — a pure local file transform, no network call ever
              made (see docs/OBSERVABILITY.md)
  mission     Goal #5: `new` scaffolds a mission record (mission.md + mission.json)
              under missions/<id>/; `status` reads it back (gate + retry summary)
  gate-status Goal #5: read-only report of which of the five canonical mission
              gates (doctrine.md "The Gates") are cleared for a mission
  retry       Goal #5: the typed-retry ledger — `log` writes
              missions/<id>/retries/<task>.attempt-N.md (REFUSES past the 3-attempt
              cap, or a same-brief retry for a non-transient cause); `check` dry-runs
              the same decision without writing anything
  run         Goal #6: the mechanical CONDUCTOR LOOP — loads + validates a crew-plan,
              then executes its stages end-to-end against a DispatchDriver (claude |
              codex | fake): gate check, dispatch, read the returned artifact back,
              mandatory verification, typed retry on failure (max 3, changed brief),
              and a hard halt + escalation record on retry-cap exhaustion or a
              verifier BLOCK
  tasks       Phase 0.2: the CROSS-HARNESS TASK STORE (TASK LEDGER region, a
              sibling of MISSION LEDGER) — file-per-task JSON under
              .tess/state/tasks/<id>.json (new | set | claim | release |
              block | pull | render | handoff); `claim` writes a claim-lease
              (host:pid:uuid) + heartbeat, `set` uses rev-CAS optimistic
              concurrency, `render` regenerates the DERIVED BOARD.md kanban
              view. Phase 0.4 (issue #125) adds the target-harness LANE:
              `new|set --lane <codex|claude-code|any>` earmarks a task
              (default `any` — unmarked, zero behavior change), `pull --lane
              <harness>` filters to that lane plus every unmarked task, and
              `handoff <id> --harness <codex|claude-code>` earmarks + prints
              a copy-pasteable invocation for an external worker session —
              it prepares, never spawns, that harness. Phase 0.5 (issue
              #129) adds `block <id> --reason ... --summary ... --progress
              ... --needed ...`: the STRUCTURED STUCK-PACKET — `handoff`'s
              sibling ("here's a task, go do it" vs. "I got stuck, here's
              everything you need to continue"), transitions status to
              `blocked` AND records a resumable-by-any-agent packet;
              `pull --status blocked` surfaces it, `set|release --status
              <away-from-blocked>` clears it as a side effect
  log         Phase 0.2: the hash-chained, append-only ACCOUNTABILITY LEDGER
              under .tess/state/ledger/<YYYY-MM>.<origin>.jsonl (sharded per
              calendar month + per writer origin) — `append` a hash-chained
              event (unsigned; see docs/STATE_LAYER.md's trust-boundary
              note), `view` read filtered/sorted events, `verify` walk a
              shard's hash chain (+ per-shard seq/tip + registry cross-
              check) and report tamper, truncation, or a deleted shard
  memory      Phase 0.3: the cross-harness MEMORY LINK (MEMORY ADOPT region,
              a sibling of TASK LEDGER) — `adopt` moves an existing harness-
              private memory directory's contents into .tess/state/memory/
              and replaces the original with a symlink, so that harness's
              own native memory reads/writes transparently land in the ONE
              canonical store every harness mounts (docs/STATE_LAYER.md).
              Dry-run by default (--yes to mutate); refuses a non-empty
              target without --merge; refuses any real filename/content
              conflict outright (no partial writes); idempotent against an
              already-adopted source; `--revert` undoes it from the
              adopt's own recorded manifest, restoring exactly the files
              that manifest recorded, never the store's current full
              contents
  audit       Goal I1: the exportable, independently-verifiable AUDITOR
              PACK — `export` selects a scope (--task ID | --since/--until |
              --all), reads the matching accountability-ledger events
              (+ any caller-supplied, already-signed Agent Receipts via
              --receipt) and writes a self-contained manifest.json +
              human-readable SUMMARY.md; `verify` re-walks the hash chain
              and re-checks embedded-receipt content-hash self-consistency
              using ONLY the pack's own bytes (no live .tess/state/ access).
              Every pack embeds a `trust_boundary` block stating plainly
              that it is tamper-evident (unsigned hash chain), not
              cryptographically non-repudiable — see docs/AUDIT_PACK_SPEC.md
  skill       Issue #131: demo-to-skill — `from-task <id>` reads a completed
              task's record + its REAL ledger trail (task-scoped, reusing
              the audit region's own `_audit_collect_events_by_shard`) and
              scaffolds a DRAFT skill fitting the existing `.claude/skills/*/
              SKILL.md` progressive-disclosure format: a step sequence
              derived from the actual ledger events (never invented text),
              a reusable-instructions section built from the task's own
              recorded notes/evidence (verbatim, gap-flagged when thin —
              e.g. mechanical status-transitions with no notes), plus a
              self-contained `provenance.json` sidecar (mirrors the audit
              pack's manifest.json convention) traceable back to the source
              task/ledger. Writes to `.tess/state/skills/drafts/<slug>/` —
              deliberately NOT `.claude/skills/` (the live, core-managed
              skill set) — so a generated draft is never auto-activated
              unattended; a human/curator reviews and promotes it manually.
              Logs its own `skill_generated` ledger event for accountability.

Merge engine: git merge-file (3-way textual). No custom diff algorithm.
"""

from __future__ import annotations  # PEP 563 — lazy annotation eval; keeps 3.9 compat (int|None, X|Y unions)

import argparse
