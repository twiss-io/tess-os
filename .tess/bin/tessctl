#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
# Copyright 2026 Twiss
"""
tessctl — Tess OS keystone CLI
Spec: kb/wiki/synthesis/2026-06-27-keystone-architecture.md §§3-5
Runtime: Python 3 (stdlib + pyyaml). No Node. Self-contained single file.

Implemented commands (Phase 1 + Phase 2 core + security hardening):
  init        scaffold operator/ stubs, run restore + render
  restore     re-sync live tree from .tess/core at locked version (no network, idempotent)
  doctor      SHA-integrity check every core-managed file; flag security-tier drift + core tamper
  update      snapshot → doctor gate → git subtree pull → per-file resolution → render → re-pin
  publish     copy core→live, status→user-published, stamp @published-from
  override    record diff vs core as patch-override in tess.lock
  capture     hash-detect in-place edit → locally-modified (security-tier → quarantined)
  rollback    restore from .tess/snapshots/<ts> + rewrite tess.lock
  diff        show core (rendered) vs live via git diff
  render      render CLAUDE.md from CLAUDE.md.tpl + operator/ stubs; render settings.json
  verify      core-integrity audit: .tess/core bytes vs base_sha + security-tier tampering check
  approve     accept a quarantined security-tier edit (the operator gate, rationale hard-required)
  resolve     resolve a conflict file: --ours / --theirs / --edit (open $EDITOR)
  validate    Phase 0 contracts-as-code: check a brief/crew-plan/verdict/return-manifest
              instance against core/contracts/*.schema.json; schema-miss classifies
              degraded_output per subagent-failure-protocol.md (see core/contracts/README.md)
  verdict     Phase 2b: `keygen` turnkey-generates a verifier's local GPG identity and
              registers it in core/policy/policy.yaml; `sign` a verdict's canonical
              content with a verifier's GPG key; `verify` a signed verdict against
              core/policy/policy.yaml's verifier_keys
  gate        Phase 2 (+2b): deterministic enforcement spine — pre-commit/pre-push/ci
              contract + covering-verdict + signature checks; install-hooks scaffolds the
              git hooks and the CI workflow (now push/pull_request-triggered, not just
              workflow_dispatch); `clear` (Goal #5) clears a mission gate — refuses
              without a real, on-disk --evidence artifact
  trace       Goal #8: local-first mission trace log — every `gate`/`validate`
              invocation appends a schema-valid JSONL event to missions/<id>/trace.jsonl
              (or a per-run fallback under .tess/trace/runs/ when no mission id is
              inferable). `trace export --format otlp-json` maps the JSONL to OTel GenAI
              semantic-convention agent spans (OTLP/JSON) for ingestion by any APM that
              understands gen_ai.* — a pure local file transform, no network call ever
              made (see docs/OBSERVABILITY.md)
  mission     Goal #5: `new` scaffolds a mission record (mission.md + mission.json)
              under missions/<id>/; `status` reads it back (gate + retry summary)
  gate-status Goal #5: read-only report of which of the five canonical mission
              gates (doctrine.md "The Gates") are cleared for a mission
  retry       Goal #5: the typed-retry ledger — `log` writes
              missions/<id>/retries/<task>.attempt-N.md (REFUSES past the 3-attempt
              cap, or a same-brief retry for a non-transient cause); `check` dry-runs
              the same decision without writing anything
  run         Goal #6: the mechanical CONDUCTOR LOOP — loads + validates a crew-plan,
              then executes its stages end-to-end against a DispatchDriver (claude |
              codex | fake): gate check, dispatch, read the returned artifact back,
              mandatory verification, typed retry on failure (max 3, changed brief),
              and a hard halt + escalation record on retry-cap exhaustion or a
              verifier BLOCK

Merge engine: git merge-file (3-way textual). No custom diff algorithm.
"""

from __future__ import annotations  # PEP 563 — lazy annotation eval; keeps 3.9 compat (int|None, X|Y unions)

