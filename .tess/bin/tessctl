        "fn": _mcp_tool_mission_status,
    },
    "roster_list": {
        "description": "List the agent roster: which agents are installed (core-managed, live) vs staged/benched.",
        "inputSchema": {"type": "object", "properties": {}},
        "fn": _mcp_tool_roster_list,
    },
}


def _mcp_call_tool(root: Path, name: str, arguments) -> dict:
    tool = MCP_TOOLS.get(name)
    if tool is None:
        raise McpError(JSONRPC_INVALID_PARAMS, f"Unknown tool: {name}")
    if arguments is None:
        arguments = {}
    if not isinstance(arguments, dict):
        raise McpError(JSONRPC_INVALID_PARAMS, f"tools/call arguments for {name!r} must be an object")
    return tool["fn"](root, arguments)


def _mcp_tools_list_result() -> dict:
    return {
        "tools": [
            {"name": name, "description": spec["description"], "inputSchema": spec["inputSchema"]}
            for name, spec in sorted(MCP_TOOLS.items())
        ]
    }


# ---------------------------------------------------------------------------
# JSON-RPC 2.0 request handling + the stdio transport loop.
# ---------------------------------------------------------------------------

def _mcp_handle_request(root: Path, req: dict):
    """Handle one parsed JSON-RPC message. Returns the response dict to
    write back (already carrying jsonrpc/id), or None for a notification
    (a request object with no `id` member) — JSON-RPC 2.0 §4/4.1: a
    notification never gets a response, success OR error."""
    is_notification = "id" not in req
    msg_id = req.get("id")
    method = req.get("method")

    def ok(result: dict):
        return None if is_notification else {"jsonrpc": "2.0", "id": msg_id, "result": result}

    def err(code: int, message: str, data=None):
        if is_notification:
            return None
        error = {"code": code, "message": message}
        if data is not None:
            error["data"] = data
        return {"jsonrpc": "2.0", "id": msg_id, "error": error}

    if not isinstance(method, str):
        return err(JSONRPC_INVALID_REQUEST, "Invalid Request: missing/non-string `method`")

    try:
        if method == "initialize":
            return ok({
                "protocolVersion": MCP_PROTOCOL_VERSION,
                "capabilities": {"tools": {"listChanged": False}},
                "serverInfo": {"name": MCP_SERVER_NAME, "version": MCP_SERVER_VERSION},
            })
        if method in ("notifications/initialized", "initialized"):
            return None  # client notification, post-initialize handshake — no response
        if method == "ping":
            return ok({})
        if method == "tools/list":
            return ok(_mcp_tools_list_result())
        if method == "tools/call":
            params = req.get("params") or {}
            tool_name = params.get("name")
            arguments = params.get("arguments")
            if not isinstance(tool_name, str):
                return err(JSONRPC_INVALID_PARAMS, "tools/call requires string `params.name`")
            try:
                result = _mcp_call_tool(root, tool_name, arguments)
            except McpError as e:
                return err(e.code, str(e), e.data)
            except Exception:  # noqa: BLE001 — deliberate boundary: an exception raised
                # INSIDE a tool's own execution is a business-logic/runtime failure, which the
                # MCP spec's "Tool Execution Errors" require be reported as `isError: true` in
                # the tools/call RESULT, never as a JSON-RPC protocol error.
                return ok({"content": [{"type": "text", "text": "TOOL_EXECUTION_FAILED"}], "isError": True})
            return ok({
                "content": [{"type": "text", "text": json.dumps(result, indent=2)}],
                "structuredContent": result,
                "isError": False,
            })
        return err(JSONRPC_METHOD_NOT_FOUND, f"Method not found: {method}")
    except McpError as e:
        return err(e.code, str(e), e.data)


def _mcp_handle_message(root: Path, req) -> dict | None:
    """Fail-safe wrapper around _mcp_handle_request: nothing in request
    handling may ever crash the stdio loop / kill the session — an
    unexpected bug becomes a JSON-RPC internal error, not a dead pipe.
    Also the single place that rejects a non-object message per JSON-RPC's
    Request shape."""
    if not isinstance(req, dict):
        return {
            "jsonrpc": "2.0", "id": None,
            "error": {"code": JSONRPC_INVALID_REQUEST, "message": "Invalid Request: not a JSON object"},
        }
    try:
        return _mcp_handle_request(root, req)
    except Exception:  # noqa: BLE001 — see docstring: this is the last-resort catch-all.
        if "id" not in req:
            return None  # was a notification — still no response, even on our own bug
        return {
            "jsonrpc": "2.0", "id": req.get("id"),
            "error": {"code": JSONRPC_INTERNAL_ERROR, "message": "INTERNAL_ERROR_REDACTED"},
        }


def _mcp_read_line(stream) -> str | None:
    """Read exactly one newline-delimited JSON-RPC message from `stream`
    (stdio transport — spec: 'Messages are delimited by newlines, and MUST
    NOT contain embedded newlines.'). Returns None at EOF (the client
    closing its write end / our stdin — the documented stdio shutdown
    sequence). Blank lines between messages are skipped (harmless
    whitespace padding some clients emit)."""
    while True:
        line = stream.readline()
        if line == "":
            return None  # EOF
        line = line.strip()
        if not line:
            continue
        return line


def _mcp_serve(root: Path, in_stream=None, out_stream=None) -> None:
    """The stdio MCP server loop. Reads one newline-delimited JSON-RPC
    message at a time from `in_stream` (default sys.stdin), dispatches it,
    writes the JSON-RPC response (if any) to `out_stream` (default
    sys.stdout) on its own line, and flushes immediately — a client
    blocked on read() must never wait on our own buffering. Exits cleanly
    at EOF. `in_stream`/`out_stream` are injectable so tests can drive the
    loop directly over real OS pipes without a subprocess, in addition to
    the subprocess-level stdio tests."""
    in_stream = in_stream if in_stream is not None else sys.stdin
    out_stream = out_stream if out_stream is not None else sys.stdout

    while True:
        line = _mcp_read_line(in_stream)
        if line is None:
            return

        try:
            req = json.loads(line)
        except json.JSONDecodeError:
            resp = {
                "jsonrpc": "2.0", "id": None,
                "error": {"code": JSONRPC_PARSE_ERROR, "message": "PARSE_ERROR"},
            }
            out_stream.write(json.dumps(resp) + "\n")
            out_stream.flush()
            continue

        if isinstance(req, list):
            # JSON-RPC batch: accepted for spec-completeness (nothing in the
            # stdio transport spec forbids a batch on one line), though real
            # MCP clients send one message per line in practice.
            responses = [r for r in (_mcp_handle_message(root, item) for item in req) if r is not None]
            if responses:
                out_stream.write(json.dumps(responses) + "\n")
                out_stream.flush()
            continue

        resp = _mcp_handle_message(root, req)
        if resp is not None:
            out_stream.write(json.dumps(resp) + "\n")
            out_stream.flush()


def cmd_mcp(args, root: Path) -> None:
    sub = getattr(args, "mcp_sub", None)
    if sub != "serve":
        sys.exit("tessctl mcp: choose a subcommand — serve")
    _mcp_serve(root)


# ---------------------------------------------------------------------------
# Main entrypoint
# ---------------------------------------------------------------------------

def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="tessctl",
        description="Tess OS keystone CLI — framework lifecycle management",
    )
    sub = parser.add_subparsers(dest="command", metavar="COMMAND")

    # init
    p_init = sub.add_parser("init", help="scaffold project from framework; run restore + render")
    p_init.add_argument("--from", dest="from_upstream", metavar="UPSTREAM", help="git upstream URL (TODO: network)")

    # restore
    p_restore = sub.add_parser("restore", help="re-sync live tree from .tess/core (no network, idempotent)")
    p_restore.add_argument("--dry-run", action="store_true", dest="dry_run")

    # doctor
    p_doctor = sub.add_parser("doctor", help="SHA-integrity check; flag security-tier drift")
    p_doctor.add_argument("--fix", action="store_true", help="auto-capture uncaptured drift")
    p_doctor.add_argument("--json", action="store_true", dest="json_out", help="machine-readable JSON output")
    # DATA-LEAK-SAFETY (issue #92): the commit-side PUBLISH-CLEAN gate — symmetric
    # to the write-gate (check_manifest_write_gate/guarded_write). A dedicated
    # flag rather than folding into the default doctor run: the SHA-integrity
    # scan and the publish-clean scan have unrelated failure semantics (an
    # operator running plain `tessctl doctor` should not suddenly start failing
    # over "is a private path staged in git", which most tessctl installs
    # aren't even a git repo when the standard doctor check matters most —
    # see cmd_doctor's early handling of --publish-clean below).
    p_doctor.add_argument(
        "--publish-clean", action="store_true", dest="publish_clean",
        help="FAIL if a staged path is private overlay data (operator PII, "
             "*.local.md, kb/**, clients/**, .env*, vault) — the pre-commit hook body",
    )
    p_doctor.add_argument(
        "--publish-clean-all", action="store_true", dest="publish_clean_all",
        help="with --publish-clean, audit the FULL git-tracked set (git ls-files) "
             "instead of just staged changes — a repo-hygiene audit, not the hook default",
    )
    p_doctor.add_argument("path", nargs="?", help="check a specific file")

    # update
    p_update = sub.add_parser("update", help="fetch new version; snapshot → doctor → signed-verify → merge → render → re-pin")
    p_update.add_argument("--check", action="store_true", help="report without writing (safe nightly version-watch)")
    p_update.add_argument("--dry-run", action="store_true", dest="dry_run")
    p_update.add_argument("--ref", metavar="TAG",
                          help="signed release tag to fetch (e.g. v2.1.0); default: framework.upstream_ref in tess.lock")
    p_update.add_argument("--to", metavar="TAG",
                          help="alias for --ref (legacy semver arg; tag used directly)")
    p_update.add_argument(
        "--trust-on-first-use", action="store_true", dest="trust_on_first_use",
        help=(
            "explicit opt-in for TOFU (trust-on-first-use) when trusted_key_fingerprint "
            "is not set in tess.lock.  Verifies the tag signature with the system keyring, "
            "pins the 40-hex fingerprint, and saves it to tess.lock.  Without this flag, "
            "fetch is refused if no fingerprint is pinned (fail-closed default)."
        ),
    )

    # publish
    p_publish = sub.add_parser("publish", help="copy core→live, status→user-published")
    p_publish.add_argument("path", nargs="?", help="path to publish (live_path or core_key)")
    p_publish.add_argument("--tag", metavar="SELECTOR", help="publish a group: hooks | doctrine | settings | entry-point")
    p_publish.add_argument("--force", action="store_true", help="show diff + confirm before re-seeding")

    # override
    p_override = sub.add_parser("override", help="record diff vs core as patch-override in tess.lock")
    p_override.add_argument("path", help="live path to override")

    # capture
    p_capture = sub.add_parser("capture", help="detect in-place edit → locally-modified + provenance log")
    p_capture.add_argument("path", nargs="?", help="specific file to capture (default: scan all core-managed)")
    p_capture.add_argument("--all", action="store_true", help="scan all files regardless of status")
    p_capture.add_argument("--dry-run", action="store_true", dest="dry_run")
    p_capture.add_argument("--rationale", metavar="TEXT", help="why this edit was made (required for security-tier files)")
    p_capture.add_argument("--source", metavar="SOURCE", default="manual", help="provenance source (default: manual)")
    p_capture.add_argument("--auto", action="store_true", help="non-interactive (hook mode)")

    # rollback
    p_rollback = sub.add_parser("rollback", help="restore from snapshot + rewrite tess.lock")
    p_rollback.add_argument("--to", metavar="TS", help="snapshot timestamp (default: most recent)")

    # diff
    p_diff = sub.add_parser("diff", help="show core (rendered) vs live")
    p_diff.add_argument("path", nargs="?", help="specific file to diff")
    p_diff.add_argument("--stat", action="store_true", help="summary only")
    p_diff.add_argument("--upstream", action="store_true", help="(TODO) diff vs upstream version")

    # render
    p_render = sub.add_parser(
        "render",
        help="render-target dispatch (Phase 1 adapter seam); default: render every "
             "ENABLED target for this install (MED-3)",
    )
    p_render.add_argument(
        "--target", action="append", choices=sorted(RENDER_TARGETS),
        help="render only this target (repeatable), bypassing this install's "
             "enablement list; default: all ENABLED targets "
             "(tess.manifest.json render_targets.enabled; today: claude-code only)",
    )
    p_render.add_argument(
        "--list-targets", action="store_true", dest="list_targets",
        help="list registered render targets and the live-tree globs each owns, then exit",
    )

    # verify (defect #3)
    p_verify = sub.add_parser("verify", help="verify .tess/core bytes vs base_sha; flag security-tier tampering")

    # approve (defect #1)
    p_approve = sub.add_parser("approve", help="accept a quarantined security-tier edit (rationale required)")
    p_approve.add_argument("path", help="live path of the quarantined file")
    p_approve.add_argument("--rationale", metavar="TEXT", default="",
                           help="REQUIRED (fail-loud if absent): reason this security-doctrine change is acceptable (the operator gate)")

    # resolve (defect #7)
    p_resolve = sub.add_parser("resolve", help="resolve a conflict file after tessctl update collision")
    p_resolve.add_argument("path", help="live path of the conflicted file")
    p_resolve_mode = p_resolve.add_mutually_exclusive_group()
    p_resolve_mode.add_argument("--ours", action="store_true", help="accept local version")
    p_resolve_mode.add_argument("--theirs", action="store_true", help="accept incoming upstream version")
    p_resolve_mode.add_argument("--edit", action="store_true", help="open $EDITOR on conflict file")

    # reset (M1) — explicit discard of a captured/locally-modified edit
    p_reset = sub.add_parser("reset", help="discard captured edit; restore from core and re-pin lock to pristine")
    p_reset.add_argument("path", help="live path to reset (must be locally-modified or core-managed)")

    # self-update
    p_selfupdate = sub.add_parser(
        "self-update",
        help="update the tessctl engine itself (.tess/bin/tessctl) from a signed upstream tag",
    )
    p_selfupdate.add_argument(
        "--ref", metavar="TAG",
        help="signed release tag to fetch (e.g. v2.1.0); default: framework.upstream_ref in tess.lock"
    )
    p_selfupdate.add_argument(
        "--to", metavar="TAG",
        help="alias for --ref (legacy semver arg)"
    )
    p_selfupdate.add_argument(
        "--trust-on-first-use", action="store_true", dest="trust_on_first_use",
        help=(
            "explicit opt-in for TOFU when trusted_key_fingerprint is not set in tess.lock. "
            "Pins the fingerprint on first use.  Without this flag, self-update is refused "
            "when no fingerprint is pinned (fail-closed default)."
        ),
    )

    # lock (M1) — CI gate verb + MAINTAINER re-baseline
    p_lock = sub.add_parser(
        "lock",
        help="lock file ops (--check: CI integrity gate; --regen: MAINTAINER re-baseline base_sha to current core)",
    )
    p_lock_mode = p_lock.add_mutually_exclusive_group()
    p_lock_mode.add_argument("--check", action="store_true",
                             help="exit non-zero if any drift, core tamper, or quarantined file found (CI gate)")
    p_lock_mode.add_argument("--regen", action="store_true",
                             help="MAINTAINER: re-pin every base_sha to sha256 of the current .tess/core file "
                                  "(re-baselines integrity to current core; requires --yes or interactive y/N)")
    p_lock.add_argument("--yes", action="store_true",
                        help="confirm --regen non-interactively (acknowledges re-baselining integrity to current core)")
    p_lock.add_argument("--only", metavar="PATH", action="append",
                        help="scope --regen to only this entry (repeatable; matches core_key or live_path). "
                             "Prefer this over an unscoped --regen for any change touching a known set of files.")

    # roster — curated-squad management (M2: staged status + install sets)
    p_roster = sub.add_parser(
        "roster",
        help="squad management: apply <path> installs a starter squad; list shows installed vs staged",
    )
    roster_sub = p_roster.add_subparsers(dest="roster_sub", metavar="SUBCOMMAND")
    p_roster_apply = roster_sub.add_parser(
        "apply",
        help="install squad+universal-base for a starter path; stage everything else (idempotent)",
    )
    p_roster_apply.add_argument(
        "path_name", metavar="PATH",
        choices=["founders", "builders", "operators"],
        help="starter path: founders | builders | operators",
    )
    roster_sub.add_parser("list", help="show installed vs staged agent counts and listing")

    # recruit — staged → core-managed + write live file
    p_recruit = sub.add_parser(
        "recruit",
        help="move staged agent(s) to installed (staged → core-managed + write live dispatch file)",
    )
    p_recruit.add_argument(
        "names", nargs="+", metavar="NAME",
        help=(
            "agent name(s) to recruit. Accepts: exact name (vega), orchestrator shorthand "
