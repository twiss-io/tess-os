    p_validate.add_argument("--json", action="store_true", dest="json_out", help="machine-readable JSON output")

    # verdict — Phase 2b verdict-signing key management
    p_verdict = sub.add_parser(
        "verdict",
        help="verdict signing key management: generate a verifier key, sign a verdict, "
             "or verify a signed verdict (Phase 2b)",
    )
    verdict_sub = p_verdict.add_subparsers(dest="verdict_sub", metavar="SUBCOMMAND")

    p_verdict_keygen = verdict_sub.add_parser(
        "keygen",
        help="turnkey onboarding: generate a local GPG identity for a named verifier, "
             "export its public key, and register it in core/policy/policy.yaml",
    )
    p_verdict_keygen.add_argument(
        "--verifier", required=True, metavar="NAME",
        help="the verifier to generate a key for (one of: Reid, Quinn, Cyra, Verity, Maialen, Lysandra)",
    )
    p_verdict_keygen.add_argument(
        "--force", action="store_true",
        help="generate a NEW keypair and REPLACE any existing public key file / policy registration "
             "for this verifier (key rotation) — refused without this flag if either already exists",
    )
    p_verdict_keygen.add_argument(
        "--gnupg-home", metavar="PATH",
        help="generate the identity in this GNUPGHOME instead of the ambient/default gpg keyring "
             "(mainly for testing; created with 0700 perms if missing)",
    )

    p_verdict_sign = verdict_sub.add_parser(
        "sign", help="sign a verdict's canonical content with a verifier's GPG key",
    )
    p_verdict_sign.add_argument("file", help="path to the verdict instance (.json, .yaml/.yml, or .md front-matter)")
    p_verdict_sign.add_argument(
        "--key-id", required=True, metavar="KEYID",
        help="local gpg identity to sign with (fingerprint, key id, or email — passed to `gpg --local-user`)",
    )
    p_verdict_sign.add_argument(
        "--verifier", metavar="NAME",
        help="the verifier this signature claims to be (must match the file's own `verifier` field, if set)",
    )
    p_verdict_sign.add_argument(
        "--gnupg-home", metavar="PATH",
        help="use this GNUPGHOME instead of the ambient/default gpg keyring (mainly for testing)",
    )
    p_verdict_sign.add_argument(
        "--output", metavar="PATH",
        help="write the signed instance here instead of overwriting the input file",
    )

    p_verdict_verify = verdict_sub.add_parser(
        "verify", help="verify a verdict's signature against core/policy/policy.yaml's verifier_keys",
    )
    p_verdict_verify.add_argument("file", help="path to the verdict instance to verify")
    p_verdict_verify.add_argument("--json", action="store_true", dest="json_out", help="machine-readable JSON output")

    # gate — Phase 2 deterministic enforcement spine
    p_gate = sub.add_parser(
        "gate",
        help="deterministic gate spine: contract validation + ship-gate (Phase 2, Decisions #2/#6)",
    )
    gate_sub = p_gate.add_subparsers(dest="gate_sub", metavar="SUBCOMMAND")

    p_gate_precommit = gate_sub.add_parser(
        "pre-commit",
        help="validate staged brief/crew-plan/verdict/return-manifest/policy files (git pre-commit hook body)",
    )
    p_gate_precommit.add_argument("--json", action="store_true", dest="json_out", help="machine-readable JSON output")

    p_gate_prepush = gate_sub.add_parser(
        "pre-push",
        help="THE SHIP-GATE: block prod/client/external changes without a covering APPROVE verdict (git pre-push hook body)",
    )
    p_gate_prepush.add_argument("--base", metavar="REF", help="explicit base ref (default: read git's pre-push stdin protocol)")
    p_gate_prepush.add_argument("--head", metavar="REF", help="explicit head ref (must be given together with --base)")
    p_gate_prepush.add_argument(
        "--verdict-dir", action="append", dest="verdict_dirs", metavar="DIR",
        help="restrict the covering-verdict search to this repo-relative dir (repeatable; default: whole repo)",
    )
    p_gate_prepush.add_argument("--json", action="store_true", dest="json_out", help="machine-readable JSON output")

    p_gate_ci = gate_sub.add_parser(
        "ci",
        help="CI entrypoint — identical ship-gate logic over an explicit ref range",
    )
    p_gate_ci.add_argument("--base", metavar="REF", required=True, help="base ref to diff from")
    p_gate_ci.add_argument("--head", metavar="REF", required=True, help="head ref to diff to")
    p_gate_ci.add_argument(
        "--verdict-dir", action="append", dest="verdict_dirs", metavar="DIR",
        help="restrict the covering-verdict search to this repo-relative dir (repeatable; default: whole repo)",
    )
    p_gate_ci.add_argument("--json", action="store_true", dest="json_out", help="machine-readable JSON output")

    gate_sub.add_parser(
        "install-hooks",
        help="install/upgrade the gate's git pre-commit + pre-push hooks and the CI workflow template",
    )

    # gate signoff — honesty-capstone-audit-2026-07-08 §3-d: hard-floor
    # sign-off signing key management (sign a sign-off, or verify a signed one)
    p_gate_signoff = gate_sub.add_parser(
        "signoff",
        help="hard-floor sign-off signing key management: sign a sign-off, or verify a signed one (§3-d)",
    )
    signoff_sub = p_gate_signoff.add_subparsers(dest="signoff_sub", metavar="SUBCOMMAND")

    p_signoff_sign = signoff_sub.add_parser(
        "sign", help="sign a hard-floor sign-off artifact's canonical content with an operator's GPG key",
    )
    p_signoff_sign.add_argument("file", help="path to the sign-off artifact (.tess/gate/signoffs/<rule-id>.signoff.json)")
    p_signoff_sign.add_argument(
        "--key-id", required=True, metavar="KEYID",
        help="local gpg identity to sign with (fingerprint, key id, or email — passed to `gpg --local-user`)",
    )
    p_signoff_sign.add_argument(
        "--gnupg-home", metavar="PATH",
        help="use this GNUPGHOME instead of the ambient/default gpg keyring (mainly for testing)",
    )
    p_signoff_sign.add_argument(
        "--output", metavar="PATH",
        help="write the signed artifact here instead of overwriting the input file",
    )

    p_signoff_verify = signoff_sub.add_parser(
        "verify", help="verify a sign-off's signature against core/policy/policy.yaml's signoff_keys",
    )
    p_signoff_verify.add_argument("file", help="path to the sign-off artifact to verify")
    p_signoff_verify.add_argument("--rule-id", required=True, metavar="ID", help="the hard-floor rule id this sign-off must match")
    p_signoff_verify.add_argument("--json", action="store_true", dest="json_out", help="machine-readable JSON output")

    # trace — Goal #8: mission trace log + OTel GenAI export
    p_trace = sub.add_parser(
        "trace",
        help="mission trace log: local JSONL event trail from gate/validate + OTel GenAI OTLP-JSON export (no network)",
    )
    trace_sub = p_trace.add_subparsers(dest="trace_sub", metavar="SUBCOMMAND")

    p_trace_export = trace_sub.add_parser(
        "export",
        help="export trace.jsonl event(s) as OTLP-JSON (OTel GenAI semantic conventions) — local transform, no network",
    )
    p_trace_export.add_argument(
        "--format", required=True, choices=["otlp-json"], dest="export_format",
        help="output format (only otlp-json is implemented)",
    )
    p_trace_export.add_argument(
        "--mission-id", metavar="ID",
        help="export only missions/<ID>/trace.jsonl (default: discover every missions/*/trace.jsonl "
             "plus the local per-run fallback files under .tess/trace/runs/)",
    )
    p_trace_export.add_argument(
        "--in", action="append", dest="in_paths", metavar="PATH",
        help="explicit JSONL file(s) to export (repeatable; overrides discovery)",
    )
    p_trace_export.add_argument(
        "--out", metavar="PATH", help="write the OTLP-JSON document here instead of stdout",
    )

    # gate clear — Goal #5 addition to the EXISTING `gate` subcommand group
    # (pre-commit/pre-push/ci/install-hooks are the Phase 2 enforcement-spine
    # verbs defined above; `clear` is mission-scoped, not push/CI-scoped).
    p_gate_clear = gate_sub.add_parser(
        "clear",
        help="clear a mission gate — REFUSES without --evidence, or if --evidence does not exist on disk",
    )
    p_gate_clear.add_argument("gate", choices=list(MISSION_GATES), help="one of the five canonical gates")
    p_gate_clear.add_argument("--mission", required=True, metavar="ID", help="mission id (missions/<id>/)")
    p_gate_clear.add_argument(
        "--evidence", required=True, metavar="PATH",
        help="path to the artifact evidencing this gate's clearance (must exist on disk)",
    )
    p_gate_clear.add_argument("--by", help="override the recorded clearer (default: current OS user)")

    # mission — Goal #5: mission records as code (mission.md + mission.json)
    p_mission = sub.add_parser(
        "mission",
        help="mission record lifecycle: scaffold (new) or read (status) a mission under missions/<id>/",
    )
    mission_sub = p_mission.add_subparsers(dest="mission_sub", metavar="SUBCOMMAND")

    p_mission_new = mission_sub.add_parser(
        "new", help="scaffold a new mission record (mission.md + mission.json) under missions/<id>/",
    )
    p_mission_new.add_argument("name", help="human-readable mission name (an id is derived: <YYYY-MM-DD>-<slug>)")
    p_mission_new.add_argument(
        "--outcome-type", dest="outcome_type",
        choices=["decide", "design", "build", "convert", "recover", "govern", "review", "communicate", "scale"],
        help="orchestra-model.md §3.1 outcome_type enum (optional)",
    )
    p_mission_new.add_argument("--by", help="override the recorded creator (default: current OS user)")

    p_mission_status = mission_sub.add_parser(
        "status", help="read a mission record's current state + gate/retry summary",
    )
    p_mission_status.add_argument("mission_id", metavar="ID", help="mission id (the missions/<id> directory name)")
    p_mission_status.add_argument("--json", action="store_true", dest="json_out")

    # gate-status — Goal #5: read-only per-mission gate report (distinct
    # top-level command from `tessctl gate` above, which is the git-diff-
    # scoped enforcement spine).
    p_gate_status = sub.add_parser(
        "gate-status",
        help="report which of the five canonical mission gates are cleared for a mission (read-only)",
    )
    p_gate_status.add_argument("mission_id", metavar="ID", help="mission id")
    p_gate_status.add_argument("--json", action="store_true", dest="json_out")

    # retry — Goal #5: the typed-retry ledger
    p_retry = sub.add_parser(
        "retry",
        help="typed-retry ledger: log a retry attempt, or check whether one would be allowed",
    )
    retry_sub = p_retry.add_subparsers(dest="retry_sub", metavar="SUBCOMMAND")

    p_retry_log = retry_sub.add_parser(
        "log",
        help="write missions/<id>/retries/<task>.attempt-N.md — REFUSES (writes nothing) if blocked",
    )
    p_retry_log.add_argument("task", help="task id this retry attempt belongs to")
    p_retry_log.add_argument("--mission", required=True, metavar="ID", help="mission id")
    p_retry_log.add_argument(
        "--cause", required=True, choices=list(RETRY_CAUSE_CLASSES),
        help="subagent-failure-protocol.md cause classification",
    )
    p_retry_log.add_argument(
        "--failure-state", required=True, dest="failure_state", choices=list(RETRY_FAILURE_STATES),
        help="subagent-failure-protocol.md failure state",
    )
    p_retry_log.add_argument(
        "--brief", required=True, metavar="PATH",
        help="path to a text file holding this attempt's dispatch-brief content "
             "(compared LITERALLY against the prior attempt's brief)",
    )
    p_retry_log.add_argument("--note", help="free-text note on what the brief changed (optional)")
    p_retry_log.add_argument("--by", help="override the recorded logger (default: current OS user)")

    p_retry_check = retry_sub.add_parser(
        "check",
        help="dry-run the same cap + same-brief check `retry log` performs, without writing anything",
    )
    p_retry_check.add_argument("task", help="task id")
    p_retry_check.add_argument("--mission", required=True, metavar="ID", help="mission id")
    p_retry_check.add_argument(
        "--cause", choices=list(RETRY_CAUSE_CLASSES),
        help="proposed cause class for the next attempt (omit together with --brief for a cap-only check)",
    )
    p_retry_check.add_argument(
        "--brief", metavar="PATH",
        help="proposed brief file for the next attempt (required together with --cause)",
    )
    p_retry_check.add_argument("--json", action="store_true", dest="json_out")

    # run — Goal #6: the mechanical conductor loop
    p_run = sub.add_parser(
        "run",
        help="Goal #6: the mechanical conductor loop — execute a validated crew-plan's stages "
             "end-to-end (gate check -> dispatch -> verify -> typed retry -> halt/escalate)",
    )
    p_run.add_argument("crew_plan", metavar="CREW-PLAN",
                        help="path to a crew-plan.schema.json instance (.json/.yaml/.md)")
    p_run.add_argument(
        "--driver", choices=sorted(RUN_DRIVERS), default="claude",
        help="dispatch driver: claude (claude -p, Tier A) | codex (codex exec, Tier B) | "
             "fake (deterministic, tests/dry-runs only)",
    )
    p_run.add_argument("--timeout", type=float, metavar="SECONDS",
                        help="per-dispatch subprocess timeout in seconds (default: 600)")
    p_run.add_argument("--fake-script", dest="fake_script", metavar="PATH",
                        help="(--driver fake only) JSON file scripting FakeDriver's per-task responses")
    p_run.add_argument("--by", help="override the recorded actor for retry/escalation records (default: current OS user)")
    p_run.add_argument("--json", action="store_true", dest="json_out", help="machine-readable JSON output")

    # mcp (Goal #9) — the gate as an MCP server
    p_mcp = sub.add_parser(
        "mcp",
        help="Goal #9: MCP server — expose validate/gate/mission/roster as MCP tools over stdio",
    )
    mcp_sub = p_mcp.add_subparsers(dest="mcp_sub", metavar="SUBCOMMAND")
    mcp_sub.add_parser(
        "serve",
        help="run a stdio JSON-RPC 2.0 MCP server (initialize / tools/list / tools/call); see docs/MCP.md",
    )

    return parser


def main() -> None:
    parser = build_parser()
    args = parser.parse_args()

    if not args.command:
        parser.print_help()
        sys.exit(0)

    root = find_tess_root()

    # LOW fix: scope tool checks to what each command actually invokes.
    # The original blanket check demanded git+diff+patch for all SUBPROCESS_COMMANDS,
    # but e.g. capture only needs diff; update needs git+patch; resolve needs nothing
    # (--ours/--theirs do no subprocess; --edit invokes $EDITOR, not checked here).
    _TOOL_REQUIREMENTS: dict[str, list[str]] = {
        "update":      ["git", "patch", "gpg"],  # signed-tag fetch (git) + merge-file (git) + patch-apply (patch) + isolated GNUPGHOME (gpg)
        "self-update": ["git", "gpg"],           # signed-tag fetch + clone + isolated GNUPGHOME
        "capture":     ["diff"],           # diff -u for provenance log
        "diff":        ["git"],            # git diff --no-index
        "doctor":      ["diff"],           # doctor --fix calls diff -u (Reid LOW-1)
        "override":    ["diff"],           # diff -u to compute patch
        "approve":     ["diff"],           # diff -u for event log
        "publish":     ["git"],            # git diff --no-index (--force mode)
        "resolve":     [],                 # --ours/--theirs: no subprocess; --edit: $EDITOR
        "gate":        ["git", "gpg"],     # changed-path discovery (git) + covering-verdict signature verify (isolated GNUPGHOME, gpg)
        "verdict":     ["gpg"],            # sign (detach-sign) / verify (isolated GNUPGHOME)
    }
    tools_needed = _TOOL_REQUIREMENTS.get(args.command, [])
    if tools_needed:
        _check_tools(*tools_needed)

    dispatch = {
        "init":         cmd_init,
        "restore":      cmd_restore,
        "doctor":       cmd_doctor,
        "update":       cmd_update,
        "self-update":  cmd_self_update,
        "publish":      cmd_publish,
        "override":     cmd_override,
        "capture":      cmd_capture,
        "rollback":     cmd_rollback,
        "diff":         cmd_diff,
        "render":       cmd_render,
        "verify":       cmd_verify,
        "approve":      cmd_approve,
        "resolve":      cmd_resolve,
        "reset":        cmd_reset,
        "lock":         cmd_lock,
        # M2: curated-squad mechanism
        "roster":       cmd_roster,
        "recruit":      cmd_recruit,
        "bench":        cmd_bench,
        # M4/M6: persona + name render layer
        "identity":     cmd_identity,
        "rename":       cmd_rename,
        "set-operator": cmd_set_operator,
        "pathway":      cmd_pathway,
        # M5: vault — age-encrypted secret store
        "vault":        cmd_vault,
        # Phase 0: contracts-as-code validator
        "validate":     cmd_validate,
        # Phase 2b: verdict signing key management
        "verdict":      cmd_verdict,
        # Phase 2: deterministic gate spine (Decisions #2/#6)
        "gate":         cmd_gate,
        # Goal #8: mission trace log + OTel GenAI export
        "trace":        cmd_trace,
        # Goal #5: mission ledger — mission records as code (MISSION LEDGER
        # region, above cmd_gate()). "gate clear" itself dispatches through
        # "gate" -> cmd_gate() -> its own handlers dict, not a top-level key here.
        "mission":      cmd_mission,
        "gate-status":  cmd_gate_status,
        "retry":        cmd_retry,
        # Goal #6: `tessctl run` — the mechanical conductor loop (RUN region,
        # directly below the MISSION LEDGER region).
        "run":          cmd_run,
        # Goal #9: `tessctl mcp serve` — the gate as an MCP server (MCP
        # region, directly below the RUN region).
        "mcp":          cmd_mcp,
    }

    fn = dispatch.get(args.command)
    if not fn:
        sys.exit(f"tessctl: unknown command: {args.command}")

    # GateError propagated out of single-file command entrypoints (cmd_publish
    # single-target, cmd_override, cmd_approve, cmd_reset, cmd_resolve,
    # _do_render, etc.) is caught here and converted to sys.exit(str(e)),
    # preserving the exact UX and exit-code behavior that sys.exit() in
    # check_manifest_write_gate produced before we switched to raising GateError.
    # Bulk callers (_do_restore, _apply_per_file_resolution, cmd_publish --tag,
    # cmd_capture scan/--all) catch GateError per-iteration before it reaches
    # here, so this handler only fires for genuinely single-target violations.
    # MissionError (Goal #5, MISSION LEDGER region) is caught the same way —
    # every cmd_mission/cmd_gate_status/cmd_retry/_cmd_gate_clear entrypoint
    # already catches it locally too; this is the defense-in-depth backstop.
    # RunError (Goal #6, RUN region) mirrors the same pattern — cmd_run
    # already catches it locally too; this is the defense-in-depth backstop.
    try:
        fn(args, root)
    except (GateError, MissionError, RunError) as e:
        sys.exit(str(e))


if __name__ == "__main__":
    main()
