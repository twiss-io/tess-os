    "validate_contract": {
        "description": (
            "Validate a contract instance (brief | crew-plan | verdict | return-manifest | "
            "mission | retry | policy) against its JSON Schema + relational lint — the same "
            "check `tessctl validate` runs. Accepts a `path` on disk, or inline `content` + "
            "`format` for a draft that has not been written to disk yet."
        ),
        "inputSchema": {
            "type": "object",
            "properties": {
                "contract_type": {
                    "type": "string",
                    "enum": sorted(CONTRACT_SCHEMAS.keys()),
                    "description": "Which contract schema to validate against.",
                },
                "path": {
                    "type": "string",
                    "description": (
                        "Path to the contract instance file (.json/.yaml/.yml/.md). Relative "
                        "paths resolve against the tess project root."
                    ),
                },
                "content": {"type": "string", "description": "Inline contract-instance content, instead of `path`."},
                "format": {
                    "type": "string",
                    "enum": ["json", "yaml", "yml", "md"],
                    "description": "Required alongside `content`: which format it's written in.",
                },
            },
            "required": ["contract_type"],
        },
        "fn": _mcp_tool_validate_contract,
    },
    "gate_check_paths": {
        "description": (
            "Run the gate's verdict-coverage ship-check for an explicit set of paths — the "
            "SAME decision engine `tessctl gate pre-push` / `tessctl gate ci` use "
            "(_gate_run_ship_check), so the result is identical to what a push of those paths "
            "at `head` against an immutable `base` commit would get. `base` is mandatory: "
            "the tool refuses candidate-trust fallback. Moves gate enforcement IN-SESSION: "
            "check before you ever commit or push."
        ),
        "inputSchema": {
            "type": "object",
            "properties": {
                "paths": {
                    "type": "array",
                    "items": {"type": "string"},
                    "description": "Repo-relative paths to check.",
                },
                "base": {
                    "type": "string",
                    "description": "Required immutable base commit ID: full 40- or 64-hex SHA only; mutable refs are rejected.",
