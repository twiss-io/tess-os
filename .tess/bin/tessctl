# 2b's `policy.verifier_keys` map is keyed by these SAME names, but a plain
# JSON Schema object node cannot itself restrict its own property NAMES to a
# fixed enum (only VALUES) — so `_lint_policy` enforces this relationally,
# the same "schema can't express it, lint does" pattern already used for
# rule-id uniqueness.
VERIFIER_NAMES = ("Reid", "Quinn", "Cyra", "Verity", "Maialen", "Lysandra")

LOCK_HEADER = """\
# tess.lock — Tess OS framework merge base of record.
# COMMITTED. Per spec kb/wiki/synthesis/2026-06-27-keystone-architecture.md sec.4.
# base_sha = sha256 of the PRISTINE .tess/core/<file> bytes at the pinned version.
# This file is the reproducibility guarantee; `tessctl verify` is the CI integrity gate
# (also available as `tessctl lock --check` for a strict CI-only non-zero-on-drift verb).
# MAINTAINER re-baseline: `tessctl lock --regen --yes` re-pins every base_sha to the
# CURRENT .tess/core bytes. Use ONLY after a deliberate, reviewed change to core (e.g. a
# de-identification scrub); it blesses whatever core is now as pristine.
"""

SECURITY_TIER_PATHS = {
    "conductor/guardrails.md",
    "conductor/verification-routing.md",
    "conductor/channel-guardrails.md",
    "conductor/dispatch-brief.md",
}

# R2 / HIGH-1: live paths whose content is generated by `tessctl render` (not
# hand-edited). When doctor detects drift on these paths the correct remedy is
# `tessctl render` (re-sync from operator-state), NEVER `tessctl capture`
# (which would launder a stale render as a deliberate local modification).
#
# HIGH-1 (Fable Phase-1 review): this used to be a Claude-only frozenset —
# only `cmd_render` consulted the `RENDER_TARGETS` registry; this classification
# set did not, so a Phase-2+ target's generated artifacts would be silently
# mis-routed to "run `tessctl capture`" (which QUARANTINEs/locally-modifies a
# stale render instead of re-rendering it). It is now DERIVED from the
# registry — see `render_generated_live_paths()` below the RENDER_TARGETS
# registry — as the union of every ENABLED target's `render_generated_paths()`.
# A frozenset constant can no longer express this (enablement is per-install,
# read from tess.manifest.json — see MED-3 / `enabled_render_targets()`), so
# every call site below now calls `render_generated_live_paths(root)` instead
# of referencing a module-level constant.

# ---------------------------------------------------------------------------
# Single security-tier predicate — canonical source of truth (§6 + defect #8)
# ---------------------------------------------------------------------------

def is_security_tier(core_key: str, attrs: dict) -> bool:
    """
    ONE predicate for security-tier determination. Used by capture, doctor,
    verify, restore, and the write gate.  Priority:
      1. tess.lock tier: security field (authoritative when set)
      2. SECURITY_TIER_PATHS fallback (handles files whose lock entry pre-dates
         the tier field, and dispatch-brief.md which is security by doctrine).
    """
    if attrs.get("tier") == "security":
        return True
    live_rel = attrs.get("live_path", "")
    if live_rel in SECURITY_TIER_PATHS:
        return True
    # Also match by core_key (e.g. .tess/core/conductor/dispatch-brief.md)
    for p in SECURITY_TIER_PATHS:
        if core_key.endswith("/" + p) or core_key == p:
            return True
    return False


