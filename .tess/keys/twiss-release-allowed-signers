# Exactly one entry. See SECURITY.md ("Release signatures").
twiss-release namespaces="tess-release" ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIN/Sl88mgPwBkzhalPjJcNNkw8qgMQNV0Ls6bzNs8zDS
