[7.291953, "o", "\r\r\n─────────────────────────────────────────────────────────\r\r\n  \u001b[1mAssembling your intelligence system.\u001b[22m\r\r\n"]
[7.799109, "o", "  \u001b[32m✓\u001b[39m \u001b[2m✦\u001b[22m Mustering your squad\r\r\n"]
