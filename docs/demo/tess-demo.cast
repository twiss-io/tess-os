[10.625472, "o", "  \u001b[32m✓\u001b[39m \u001b[2m✦\u001b[22m Marking you as Commander Avery\r\r\n"]
[10.819616, "o", "  \u001b[32m✓\u001b[39m \u001b[2m✦\u001b[22m Attuning Tess to your command\r\r\n"]
[11.331017, "o", "  \u001b[32m✓\u001b[39m \u001b[2m✦\u001b[22m Forging the doctrine\r\r\n"]
