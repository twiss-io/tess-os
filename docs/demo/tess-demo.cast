[3.340526, "o", "\u001b[999D\u001b[4A\u001b[2B\u001b[2K\u001b[G\u001b[36m│\u001b[39m  Ave\u001b[7m\u001b[8m_\u001b[28m\u001b[27m\u001b[2B"]
