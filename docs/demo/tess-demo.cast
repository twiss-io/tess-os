[3.341885, "o", "\u001b[999D\u001b[4A\u001b[1B\u001b[J\u001b[32m◇\u001b[39m  You'll need a name in these lands. What do they call you?\r\r\n\u001b[90m│\u001b[39m  \u001b[2mAvery\u001b[22m"]
[3.341991, "o", "\r\r\n\u001b[?25h"]
[3.342011, "o", "\u001b[90m│\u001b[39m\r\r\n\u001b[32m◆\u001b[39m  Commander Avery — set. Every agent in this system answers to you.\r\r\n"]
[3.343779, "o", "\u001b[?25l\u001b[90m│\u001b[39m\r\r\n\u001b[36m◆\u001b[39m  Your starter squad. ~150 agents stand by; you start with a few who are excellent.\r\r\n\u001b[36m│\u001b[39m  \u001b[32m●\u001b[39m FOUNDER'S SQUAD \u001b[2m(Strategic · Commercial · High-stakes)\u001b[22m\r\r\n\u001b[36m│\u001b[39m  \u001b[2m○\u001b[22m \u001b[2mBUILDER'S SQUAD\u001b[22m\r\r\n\u001b[36m│\u001b[39m  \u001b[2m○\u001b[22m \u001b[2mOPERATOR'S SQUAD\u001b[22m\r\r\n\u001b[36m└\u001b[39m\r\r\n"]
[3.8519, "o", "\u001b[999D\u001b[6A\u001b[1B\u001b[J\u001b[32m◇\u001b[39m  Your starter squad. ~150 agents stand by; you start with a few who are excellent.\r\r\n\u001b[90m│\u001b[39m  \u001b[2mFOUNDER'S SQUAD\u001b[22m"]
[3.851945, "o", "\r\r\n"]
[3.852094, "o", "\u001b[?25h"]
[3.852335, "o", "\r\r\n╔══════════════════════════════════════════════════════════════════════╗\r\r\n║ FOUNDER'S SQUAD — your squad                                         ║\r\r\n║                                                                      ║\r\r\n║ Athena — Chief Strategy Officer                                      ║\r\r\n║ Apolline — Chief Sales Strategist                                    ║\r\r\n║ Zélie — Presentation & Deck Design                                   ║\r\r\n║ Leah — Researcher — research gate, informs every mission  (always on)║\r\r\n║ Eva — Talent & Recruiting — pulls agents off the bench  (always on)  ║\r\r\n║                                                                      ║\r\r\n║ Orchestrators: Founder's Office · Revenue                            ║\r\r\n╚═══════════════════════"]
[3.85235, "o", "════"]
[3.852363, "o", "═══════════════════════════════════════════╝\r\r\n"]
[3.852463, "o", "\u001b[2m  Zélie designs your decks — but no narrative writer ships with this squad.\u001b[22m\r\r\n\u001b[2m  So \"frame your investor pitch\" is your natural FIRST RECRUIT, not a day-one promise.\u001b[22m\r\r\n"]
[3.854366, "o", "\u001b[?25l\u001b[90m│\u001b[39m\r\r\n\u001b[36m◆\u001b[39m  Your conductor. This platform is Tess OS; the conductor is the command-layer\r\r\nintelligence you're about to name — the one who routes your missions and briefs\r\r\nyour squad. Its default name is Tess, but this is your system.\r\r\nWhat will you call your conductor?  (Enter to keep Tess)\r\r\n\u001b[36m│\u001b[39m  \u001b[7mT\u001b[27m\u001b[2mess\u001b[22m\r\r\n\u001b[36m└\u001b[39m\r\r\n"]
[4.365153, "o", "\u001b[999D\u001b[7A"]
[4.365201, "o", "\u001b[1B\u001b[J\u001b[32m◇\u001b[39m  Your conductor. This platform is Tess OS; the conductor is the command-layer\r\r\nintelligence you're about to name — the one who routes your missions and briefs\r\r\nyour squad. Its default name is Tess, but this is your system.\r\r\nWhat will you call your conductor?  (Enter to keep Tess)\r\r\n\u001b[90m│\u001b[39m  \u001b[2mTess\u001b[22m"]
[4.365334, "o", "\r\r\n\u001b[?25h"]
[4.365463, "o", "\u001b[90m│\u001b[39m\r\r\n\u001b[32m◆\u001b[39m  Tess — that's the name. Your conductor routes every mission and brings every thread back to you.\r\r\n"]
[4.367643, "o", "\u001b[?25l\u001b[90m│\u001b[39m\r\r\n\u001b[36m◆\u001b[39m  How should Tess show up in the room?\r\r\n\u001b[36m│\u001b[39m  \u001b[32m●\u001b[39m CHIEF OF STAFF \u001b[2m(Formal, precise, executive.)\u001b[22m\r\r\n\u001b[36m│\u001b[39m  \u001b[2m○\u001b[22m \u001b[2mCO-FOUNDER\u001b[22m\r\r\n\u001b[36m│\u001b[39m  \u001b[2m○\u001b[22m \u001b[2mSTRATEGIST\u001b[22m\r\r\n\u001b[36m│\u001b[39m  \u001b[2m○\u001b[22m \u001b[2mGUIDE\u001b[22m\r\r\n\u001b[36m│\u001b[39m  \u001b[2m○\u001b[22m \u001b[2mOPERATOR\u001b[22m\r\r\n\u001b[36m└\u001b[39m\r\r\n"]
[4.876204, "o", "\u001b[999D\u001b[8A\u001b[1B\u001b[J\u001b[32m◇\u001b[39m  How should Tess show up in the room?\r\r\n\u001b[90m│\u001b[39m  \u001b[2mCHIEF OF STAFF\u001b[22m\r\r\n"]
[4.876256, "o", "\u001b[?25h"]
[4.876493, "o", "\u001b[90m│\u001b[39m\r\r\n\u001b[32m◆\u001b[39m  Chief of Staff pathway — set.  \"Tess: Three items are live. I'll brief you in priority order.\"\r\r\n"]
[4.878504, "o", "\u001b[?25l\u001b[90m│\u001b[39m\r\r\n\u001b[36m◆\u001b[39m  Connect Telegram now?  (optional — you can do this later)\r\r\n\u001b[36m│\u001b[39m  \u001b[2m○\u001b[22m \u001b[2mYes\u001b[22m \u001b[2m/\u001b[22m \u001b[32m●\u001b[39m No\r\r\n\u001b[36m└\u001b[39m\r\r\n"]
[5.38896, "o", "\u001b[1A"]
[5.389071, "o", "\r\r\n"]
[5.389141, "o", "\u001b[?25h"]
[5.391055, "o", "\u001b[999D\u001b[4A\u001b[1B\u001b[J\u001b[32m◇\u001b[39m  Connect Telegram now?  (optional — you can do this later)\r\r\n\u001b[90m│\u001b[39m  \u001b[2mNo\u001b[22m\r\r\n\u001b[90m│\u001b[39m\r\r\n\u001b[34m●\u001b[39m  Skipped. Run /telegram:configure anytime to wire a channel.\r\r\n\u001b[90m│\u001b[39m\r\r\n\u001b[32m◇\u001b[39m  \u001b[0mHere's the world you've built\u001b[0m \u001b[90m─────╮\u001b[39m\r\r\n\u001b[90m│\u001b[39m  \u001b[2m\u001b[22m                                   \u001b[90m│\u001b[39m\r\r\n\u001b[90m│\u001b[39m  \u001b[2mCommander Avery\u001b[22m                    \u001b[90m│\u001b[39m\r\r\n\u001b[90m│\u001b[39m  \u001b[2mWorld      The Guild Path\u001b[22m          \u001b[90m│\u001b[39m\r\r\n\u001b[90m│\u001b[39m  \u001b[2msquad      FOUNDER'S SQUAD\u001b[22m         \u001b[90m│\u001b[39m\r\r\n\u001b[90m│\u001b[39m  \u001b[2mConductor  Tess  (chief-of-staff)\u001b[22m  \u001b[90m│\u001b[39m\r\r\n\u001b[90m│\u001b[39m  \u001b[2mTelegram   skipped\u001b[22m                 \u001b[90m│\u001b[39m\r\r\n\u001b[90m│\u001b[39m  \u001b[2m\u001b[22m                                   \u001b[90m│\u001b[39m\r\r\n\u001b[90m├─────────────────────────────────────╯\u001b[39m\r\r\n"]
[5.392257, "o", "\u001b[?25l\u001b[90m│\u001b[39m\r\r\n\u001b[36m◆\u001b[39m  Open the gates?\r\r\n\u001b[36m│\u001b[39m  \u001b[32m●\u001b[39m Yes \u001b[2m/\u001b[22m \u001b[2m○\u001b[22m \u001b[2mChange something\u001b[22m\r\r\n\u001b[36m└\u001b[39m\r\r\n"]
