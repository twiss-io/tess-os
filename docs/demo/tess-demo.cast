[0.01594, "o", "$ node create-tess/bin/create-tess.mjs my-os\r\n"]
[1.135273, "o", "  \u001b[2mFetching keystone (bundled template — no network required) …\u001b[22m\r\r\n"]
[2.309595, "o", "\r\r\n   ┌────────────────────────────────────────────┐\r\r\n   │            T  E  S  S     O  S             │\r\r\n   │          intelligence conductor os         │\r\r\n   └────────────────────────────────────────────┘\r\r\n   v0.1  •  ~150 agents standing by  •  6 orchestrators loaded\r\r\n\r\r\n"]
[2.309708, "o", "\u001b[90m┌\u001b[39m  \u001b[33mTess OS — founding setup\u001b[39m\r\r\n"]
[2.315376, "o", "\u001b[?25l\u001b[90m│\u001b[39m\r\r\n\u001b[36m◆\u001b[39m  Every operator runs their world a different way. Choose how yours is framed.\r\r\n\u001b[36m│\u001b[39m  \u001b[32m●\u001b[39m The Guild Path \u001b[2m(RPG)\u001b[22m\r\r\n\u001b[36m│\u001b[39m  \u001b[2m○\u001b[22m \u001b[2mThe Tactical Path\u001b[22m\r\r\n\u001b[36m│\u001b[39m  \u001b[2m○\u001b[22m \u001b[2mThe Studio Path\u001b[22m\r\r\n\u001b[36m└\u001b[39m\r\r\n"]
[2.827191, "o", "\u001b[999D\u001b[6A\u001b[1B\u001b[J\u001b[32m◇\u001b[39m  Every operator runs their world a different way. Choose how yours is framed.\r\r\n\u001b[90m│\u001b[39m  \u001b[2mThe Guild Path\u001b[22m"]
[2.827434, "o", "\r\r\n"]
[2.82768, "o", "\u001b[?25h"]
[2.827837, "o", "\u001b[90m│\u001b[39m\r\r\n\u001b[32m◆\u001b[39m  The Guild Path — engaged.   Squads. Missions. Recruits. Your army starts small.\r\r\n\u001b[90m│\u001b[39m\r\r\n\u001b[90m│\u001b[39m  \u001b[2mSame engine underneath — the vibe sets the language, not the power.\u001b[22m\r\r\n\r\r\n     ✦ · · · · · · · · · · · · · · · · · ✦\r\r\n   ·       ████████╗███████╗███████╗███████╗  ·\r\r\n   ·          ██║   █████╗  ███████╗███████╗  ·\r\r\n   ·          ██║   ██╔══╝  ╚════██║╚════██║  ·\r\r\n   ·          ██║   ███████╗███████║███████║  ·\r\r\n   ·          ╚═╝   ╚══════╝╚══════╝╚══════╝  ·\r\r\n   ·          INTELLIGENCE CONDUCTOR OS       ·\r\r\n     ✦ · · · · · · · · · · · · · · · · · ✦\r\r\n  v0.1  •  ~150 agents standing by  •  6 orchestrators loaded\r\r\n"]
[2.828097, "o", "\u001b[90m│\u001b[39m\r\r\n\u001b[32m◇\u001b[39m  \u001b[0mThe Guild Path\u001b[0m \u001b[90m───────────────────────────────────────────────────────────────────╮\u001b[39m\r\r\n\u001b[90m│\u001b[39m  \u001b[2m\u001b[22m                                                                                  \u001b[90m│\u001b[39m\r\r\n\u001b[90m│\u001b[39m  \u001b[2mA different kind of intelligence has been running here. Not a single AI — a\u001b[22m       \u001b[90m│\u001b[39m\r\r\n\u001b[90m│\u001b[39m  \u001b[2mcoordinated crew of specialists: strategists, engineers, researchers, operators,\u001b[22m  \u001b[90m│\u001b[39m\r\r\n\u001b[90m│\u001b[39m  \u001b[2mbuilders. Each one deployable on command. This is Tess OS. Welcome, Commander.\u001b[22m    \u001b[90m│\u001b[39m\r\r\n\u001b[90m│\u001b[39m  \u001b[2m\u001b[22m                                                                                  \u001b[90m│\u001b[39m\r\r\n\u001b[90m├────────────────────────────────────────────"]
[2.828121, "o", "──"]
[2.82825, "o", "──────────────────────────────────────╯\u001b[39m\r\r\n"]
[2.830077, "o", "\u001b[?25l\u001b[90m│\u001b[39m\r\r\n\u001b[36m◆\u001b[39m  You'll need a name in these lands. What do they call you?\r\r\n\u001b[36m│\u001b[39m  \u001b[7mY\u001b[27m\u001b[2mour name\u001b[22m\r\r\n\u001b[36m└\u001b[39m\r\r\n"]
