[11.604173, "o", "  \u001b[32m✓\u001b[39m \u001b[2m✦\u001b[22m Installing gate hooks (tessctl gate install-hooks)\r\r\n"]
[13.433348, "o", "  \u001b[32m✓\u001b[39m tessctl doctor — OK\r\r\n"]
[13.43344, "o", "  \u001b[32m✓\u001b[39m tessctl verify — OK\r\r\n"]
[13.434397, "o", "  \u001b[32m✓\u001b[39m git init — repository created\r\r\n  \u001b[32m✓\u001b[39m tessctl gate install-hooks — pre-commit/pre-push hooks + CI workflow live\r\r\n\r\r\n  \u001b[33m!\u001b[39m Local scaffold ready; protected production work remains blocked.\r\r\n\u001b[2m    This project ships with empty policy registries — fail-closed by\r\r\n    design: you register your own verifier and sign-off keys. (The\r\r\n    framework maintainer repository separately registers its own\r\r\n    verifiers, in its own policy, to govern its own development — that\r\r\n    registration is never carried into a scaffolded project.) So\r\r\n    a first governed push can fail closed with no covering APPROVE verdict\r\r\n    found. Do not bypass or disable the hook to represent a change as\r\r\n    protected, or create, register, or sign review authority from this\r\r\n    candidate repository. Record the\r\r\n    gate output and base/head references, then escalate to Xavier for an\r\r\n    external custody decision and required GitHub-check enforcement.\r\r\n\u001b[22m  \u001b[33m★\u001b[39m  Local scaffo"]
[13.435195, "o", "ld complete; production protection requires external custody and required GitHub checks.\r\r\n\r\r\n─────────────────────────────────────────────────────────\r\r\nTess — intelligence conductor — online.\r\r\nCommander Avery. Your squad is assembled and standing by:\r\r\n  Athena · Apolline · Zélie · Leah · Eva\r\r\nOrchestrators active: Founder's Office · Revenue.\r\r\nBriefed and ready. What's the first mission?\r\r\n▶  /add-mission [brief your first mission here]\r\r\n─────────────────────────────────────────────────────────\r\r\n\u001b[2mTip: your squad grows when you're ready.  /list-agents · /add-agent (Eva runs intake).\u001b[22m\r\r\n"]
[14.961888, "o", "\r\n$ make receipt-demo    # show me the receipt\r\n"]
[15.995278, "o", "./examples/receipt-demo/run_demo.sh\r\n"]
[16.196517, "o", "\r\n==============================================================================\r\nSTEP 0 — generate ephemeral, demo-only GPG identities\r\n==============================================================================\r\nThese keys are generated fresh for this run only. They are NEVER\r\nregistered in core/policy/policy.yaml's verifier_keys/signoff_keys,\r\nand are destroyed when this script exits. Nothing here creates or\r\ntouches this repository's real trust anchor.\r\n"]
[17.154633, "o", "  Reid (demo/test key)           fingerprint: 3D48C40A7FB226105CAC3CFA4E2B0CAC6320B7DD\r\n  demo-operator (demo/test key)  fingerprint: F79FCE7BEEA1DCBEA81C909B28E326006DB0F310\r\n"]
[17.15466, "o", "\r\n==============================================================================\r\nSTEP 1 — propose + approve + sign: Receipt 0 (AI-verifier 'verdict')\r\n==============================================================================\r\n"]
[17.382774, "o", "  proposed_action.summary : Proposed a documentation change to docs/AGENT_RECEIPT_SPEC.md\r\n  policy_decision.rule_id : demo-docs-review\r\n  decision_kind           : verdict (signed by Reid)\r\n  chain.sequence          : 0 (genesis)\r\n\r\n==============================================================================\r\nSTEP 2 — propose + approve + sign: Receipt 1 (human 'sign-off', hard floor)\r\n==============================================================================\r\n"]
[17.628909, "o", "  proposed_action.summary : Proposed a sandbox-to-sandbox test funds transfer\r\n  policy_decision.rule_id : demo-money-movement (money_movement)\r\n  decision_kind           : signoff (signed by demo-operator)\r\n  chain.sequence          : 1, chained from Receipt 0\r\n\r\n==============================================================================\r\nSTEP 3 — journal: write the receipt chain + public keys to disk\r\n==============================================================================\r\n"]
[17.629703, "o", "  wrote examples/receipt-demo/.output/receipt-chain.jsonl (2 receipts) + both demo public keys\r\n\r\n==============================================================================\r\nSTEP 4 — verify: run the STANDALONE verifier as an independent third party would\r\n==============================================================================\r\n"]
[20.511743, "o", "CHAIN INTACT (2 receipts) — /private/tmp/tess-os/examples/receipt-demo/.output/receipt-chain.jsonl\r\n\r\n==============================================================================\r\nSTEP 5 — negative control: tamper with Receipt 1 and verify AGAIN\r\n==============================================================================\r\nFlipping receipt-1's rationale AFTER it was signed, without re-signing —\r\nthis must be REJECTED, not silently accepted.\r\n"]
[20.574314, "o", "receipt /private/tmp/tess-os/examples/receipt-demo/.output/receipt-1-tampered.json: INVALID\r\n  - decision.signature.signed_content_sha256 does not match the CURRENT canonical content — decision was edited/tampered with after signing (fail-closed)\r\n  - receipt_signature.signature.signed_content_sha256 does not match the CURRENT canonical content — receipt_signature was edited/tampered with after signing (fail-closed)\r\n\r\nConfirmed: the tampered receipt was correctly rejected.\r\n\r\n==============================================================================\r\nDEMO COMPLETE\r\n==============================================================================\r\n"]
[20.574993, "o", "Artifacts written under: examples/receipt-demo/.output\r\nCHAIN INTACT for the untampered receipts; the tampered copy was rejected.\r\n"]
