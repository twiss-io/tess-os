  "f8:q-claude": "rm -rf ?claude",
  "f8:br-claude": "rm -rf [.]claude/hooks",
  "f8:star-tess": "rm -rf *tess/bin",
  "f8:star-settings": "cp src/a.py *claude/settings.local.json",
  "f8:home-star": "rm -rf @H/*",
  "f8:home-star-settings": "cp src/a.py @H/*/settings.json",
  "f8:ext-caret": "rm -rf ^src",
  "f8:ext-caret-dir": "rm -rf conductor/^x",
  "f8:ext-caret-mid": "rm -f conductor/guard^x",
  "f8:ext-tilde": "rm -rf *~src",
  "f8:ext-tilde-end": "rm -f *~",
  "f8:ext-tilde-mid": "rm -f CLAUDE.md~x",
  "f8:ext-hash": "rm -f CLAUDE.md#",
  "f8:ext-hash2": "rm -f CLAUDE.m#d",
  "f8:ext-hash-star": "rm -rf .claude/hook#s",
  "f8:ext-caret-dot": "rm -rf .^x/hooks",
  "f8:ext-var": "X='^src'; rm -rf $X",
  "f8:zsh-range": "rm -f CLAUDE<->.md",
  "f8:procsub-u1": "cat <(ln -s .claude zz) && rm -rf **/zz/hooks",
  "f8:procsub-u1b": "rm -rf ***/hooks <(ln -s .claude zz)",
  "f8:ok-src": "rm -rf src/*",
  "f8:ok-src-tilde": "rm -f src/*~",
  "f8:ok-pycache": "rm -rf **/__pycache__",
  "f8:ok-pyc": "rm -f **/*.pyc",
  "f8:ok-ls": "ls -a * && ls **/*.py",
  "f8:ok-grep": "grep -rn print src/*",
  "f8:u1-settings": "rm -f **/settings.json",
  "f8:star-settings-json": "rm -f */settings.json",
  "f8:u1-chmod-hooks": "chmod -R 777 **/hooks",
  "f8:u1-git-hook": "rm -f **/hooks/pre-commit.sample",
  "a4:nullshift-curl": "curl -o @T/zznone*.none @P/.claude/settings.json",
  "a4:nullshift-sort": "sort -o @T/zznone*.none @P/.claude/hooks/tess-gate.py",
  "a4:nullshift-cp": "cp @T/zznone*.none @P/.claude/hooks/tess-gate.py",
  "a4:nullshift-tar": "tar czf @T/zznone*.none @P/.claude",
  "a4:null-ok-curl": "curl -o @T/out.json https://example.invalid/x",
  "a4:null-ok-cp": "cp @P/src/a.py @P/web/dist/",
  "a4:globassign-prot": "X=@P/.cla*/hooks/tess-gate.py; cp @T/evil \"$X\"",
  "a4:globassign-ok": "X=@P/src/*.py; printf '%s\\n' \"$X\""
 }
}
