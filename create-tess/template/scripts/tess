#!/usr/bin/env python3
"""Tess launcher: open this instance in a runtime CLI.

  scripts/tess claude|codex|gemini [--print-cmd] [-- extra args for the CLI]
  scripts/tess hooks-status [--runtime claude|codex]

hooks-status (read-only) prints one plain line saying whether Tess's hooks,
and so its safety checks, ran in the CURRENT session: the SessionStart and
UserPromptSubmit hooks write .tess/state/hooks-alive.json (runtime + session
id + time; see scripts/brain/brainlib/hooksalive.py), and the session id comes
from CODEX_THREAD_ID (Codex) or CLAUDE_CODE_SESSION_ID (Claude Code). Exit 0
on, 1 off, 3 when the runtime or session cannot be told (it then prints why).
The BOOT block in AGENTS.md / CLAUDE.md runs it at the first reply.

While onboarding is pending (or in progress, or a deferral has come due) it
passes the start prompt, so the first thing the runtime does is the next
onboarding question:
  claude "/brain-onboard"   codex '$brain-onboard'   gemini -i "Use the brain-onboard skill."
Once onboarding is complete, skipped or deferred it starts the CLI plainly.
Extra CLI args go before the start prompt. --print-cmd prints the command
instead of running it. Any other runtime name is a usage error that also says
how to start there (open the folder and say "hi"). Exit 127 when the CLI is
not on PATH. Stdlib only.
"""
from __future__ import annotations

import json
import os
import shlex
import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
START = {
    "claude": ["claude", "/brain-onboard"],
    "codex": ["codex", "$brain-onboard"],
    "gemini": ["gemini", "-i", "Use the brain-onboard skill."],
}
PENDING = ("pending", "in_progress")


def onboarding_status() -> str:
    tool = ROOT / "scripts" / "brain" / "onboard.py"
    if not tool.exists():
        return "unknown"
    try:
        done = subprocess.run([sys.executable, "-I", "-B", str(tool), "status", "--json"], cwd=str(ROOT),
                              capture_output=True, text=True, timeout=20)
        status = json.loads(done.stdout).get("status", "unknown")
    except (OSError, ValueError, subprocess.SubprocessError) as exc:
        print("tess: onboarding status unavailable (%s); starting plainly" % exc, file=sys.stderr)
        return "unknown"
    if status == "source-repo":
        print("tess: this is the Tess OS source repo, so onboarding is off here. Install an "
              "instance with `npm create tess@latest <folder>`.", file=sys.stderr)
    return status


HOOKS_ALIVE = ROOT / ".tess" / "state" / "hooks-alive.json"
RUNTIME_LABEL = {"codex": "Codex", "claude": "Claude Code"}
HOOKS_OFF = {
    "codex": "Tess's safety checks are OFF in this Codex session \u2014 type /hooks and approve "
             "Tess's hooks, then start a new session.",
    "claude": "Tess's safety checks are OFF in this Claude Code session \u2014 type /hooks, check "
              "that Tess's hooks are listed and turned on, then start a new session.",
}


def current_session(forced: str = "") -> tuple:
    """(runtime, session id) of the session running this command. Codex first: a Codex
    started from inside Claude Code inherits CLAUDE_CODE_SESSION_ID."""
    codex = os.environ.get("CODEX_THREAD_ID") or os.environ.get("CODEX_SESSION_ID") or ""
    claude = os.environ.get("CLAUDE_CODE_SESSION_ID") or ""
    if forced:
        return forced, codex if forced == "codex" else claude if forced == "claude" else ""
    if codex:
        return "codex", codex
    if claude:
        return "claude", claude
    return "", ""


def hooks_status(argv: list) -> int:
    forced = argv[argv.index("--runtime") + 1] if "--runtime" in argv[:-1] else ""
    runtime, sid = current_session(forced)
    if runtime not in HOOKS_OFF:
        print("Tess can't tell which app this session runs in, so it can't check its safety "
              "checks here.")
        return 3
    if not sid:
        print("Tess can't read this %s session's id, so it can't check its safety checks here."
              % RUNTIME_LABEL[runtime])
        return 3
    try:
        doc = json.loads(HOOKS_ALIVE.read_text(encoding="utf-8"))
        rows = doc.get(runtime) if isinstance(doc, dict) else None
    except (OSError, ValueError):
        rows = None
    if any(isinstance(r, dict) and r.get("session_id") == sid for r in rows or []):
        print("Tess's safety checks are on in this %s session." % RUNTIME_LABEL[runtime])
        return 0
    print(HOOKS_OFF[runtime])
    return 1


def command(runtime: str, status: str, extra: list) -> list:
    if status in PENDING:
        return [runtime] + extra + START[runtime][1:]
    return [runtime] + extra


def main(argv: list) -> int:
    args = list(argv)
    if args[:1] == ["hooks-status"]:
        return hooks_status(args[1:])
    extra = args[args.index("--") + 1:] if "--" in args else []
    args = args[: args.index("--")] if "--" in args else args
    print_only = "--print-cmd" in args
    names = [a for a in args if not a.startswith("-")]
    if len(names) != 1:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    runtime = names[0]
    if runtime not in START:
        print("usage: scripts/tess claude|codex|gemini [--print-cmd] [-- args]. For %s, open %s "
              "in it and say \"hi\": onboarding starts from AGENTS.md." % (runtime, ROOT), file=sys.stderr)
        return 2
    cmd = command(runtime, onboarding_status(), extra)
    if print_only:
        print(" ".join(shlex.quote(c) for c in cmd))
        return 0
    if shutil.which(cmd[0]) is None:
        print("tess: %s is not on PATH; install it or open this folder in another runtime" % cmd[0],
              file=sys.stderr)
        return 127
    os.chdir(str(ROOT))
    try:
        os.execvp(cmd[0], cmd)
    except OSError as exc:
        print("tess: cannot start %s: %s" % (cmd[0], exc), file=sys.stderr)
        return 127
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
