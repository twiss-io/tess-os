[0.030598, "o", "$ node create-tess/bin/create-tess.mjs my-os\r\n"]
[1.249864, "o", "  \u001b[2mFetching keystone (bundled template — no network required) …\u001b[22m\r\r\n"]
[3.558362, "o", "\r\r\n   ┌────────────────────────────────────────────┐\r\r\n   │            T  E  S  S     O  S             │\r\r\n   │          intelligence conductor os         │\r\r\n   └────────────────────────────────────────────┘\r\r\n   v0.1  •  ~150 agents standing by  •  6 orchestrators loaded\r\r\n\r\r\n\u001b[90m┌\u001b[39m  \u001b[33mTess OS — founding setup\u001b[39m\r\r\n"]
[3.565616, "o", "\u001b[?25l\u001b[90m│\u001b[39m\r\r\n\u001b[36m◆\u001b[39m  Every operator runs their world a different way. Choose how yours is framed.\r\r\n\u001b[36m│\u001b[39m  \u001b[32m●\u001b[39m The Guild Path \u001b[2m(RPG)\u001b[22m\r\r\n\u001b[36m│\u001b[39m  \u001b[2m○\u001b[22m \u001b[2mThe Tactical Path\u001b[22m\r\r\n\u001b[36m│\u001b[39m  \u001b[2m○\u001b[22m \u001b[2mThe Studio Path\u001b[22m\r\r\n\u001b[36m└\u001b[39m\r\r\n"]
[4.070235, "o", "\u001b[999D\u001b[6A\u001b[1B\u001b[J\u001b[32m◇\u001b[39m  Every operator runs their world a different way. Choose how yours is framed.\r\r\n\u001b[90m│\u001b[39m  \u001b[2mThe Guild Path\u001b[22m"]
[4.070691, "o", "\r\r\n"]
[4.071449, "o", "\u001b[?25h"]
[4.071643, "o", "\u001b[90m│\u001b[39m\r\r\n\u001b[32m◆\u001b[39m  The Guild Path — engaged.   Squads. Missions. Recruits. Your army starts small.\r\r\n"]
[4.071697, "o", "\u001b[90m│\u001b[39m\r\r\n\u001b[90m│\u001b[39m  \u001b[2mSame engine underneath — the vibe sets the language, not the power.\u001b[22m\r\r\n"]
[4.071894, "o", "\r\r\n     ✦ · · · · · · · · · · · · · · · · · ✦\r\r\n   ·       ████████╗███████╗███████╗███████╗  ·\r\r\n   ·          ██║   █████╗  ███████╗███████╗  ·\r\r\n   ·          ██║   ██╔══╝  ╚════██║╚════██║  ·\r\r\n   ·          ██║   ███████╗███████║███████║  ·\r\r\n   ·          ╚═╝   ╚══════╝╚══════╝╚══════╝  ·\r\r\n   ·          INTELLIGENCE CONDUCTOR OS       ·\r\r\n     ✦ · · · · · · · · · · · · · · · · · ✦\r\r\n  v0.1  •  ~150 agents standing by  •  6 orchestrators loaded\r\r\n"]
[4.072192, "o", "\u001b[90m│\u001b[39m\r\r\n\u001b[32m◇\u001b[39m  \u001b[0mThe Guild Path\u001b[0m \u001b[90m───────────────────────────────────────────────────────────────────╮\u001b[39m\r\r\n\u001b[90m│\u001b[39m  \u001b[2m\u001b[22m                                                                                  \u001b[90m│\u001b[39m\r\r\n\u001b[90m│\u001b[39m  \u001b[2mA different kind of intelligence has been running here. Not a single AI — a\u001b[22m       \u001b[90m│\u001b[39m\r\r\n\u001b[90m│\u001b[39m  \u001b[2mcoordinated crew of specialists: strategists, engineers, researchers, operators,\u001b[22m  \u001b[90m│\u001b[39m\r\r\n\u001b[90m│\u001b[39m  \u001b[2mbuilders. Each one deployable on command. This is Tess OS. Welcome, Commander.\u001b[22m    \u001b[90m│\u001b[39m\r\r\n\u001b[90m│\u001b[39m  \u001b[2m\u001b[22m                                                                                  \u001b[90m│\u001b[39m\r\r\n\u001b[90m├────────────────────────────────────────────"]
[4.072227, "o", "──"]
[4.072272, "o", "──────────────────────────────────────╯\u001b[39m\r\r\n"]
[4.074733, "o", "\u001b[?25l\u001b[90m│\u001b[39m\r\r\n\u001b[36m◆\u001b[39m  You'll need a name in these lands. What do they call you?\r\r\n\u001b[36m│\u001b[39m  \u001b[7mY\u001b[27m\u001b[2mour name\u001b[22m\r\r\n\u001b[36m└\u001b[39m\r\r\n"]
[4.580998, "o", "\u001b[999D\u001b[4A\u001b[2B\u001b[2K\u001b[G\u001b[36m│\u001b[39m  A\u001b[7m\u001b[8m_\u001b[28m\u001b[27m\u001b[2B"]
[4.581933, "o", "\u001b[999D\u001b[4A\u001b[2B\u001b[2K\u001b[G\u001b[36m│\u001b[39m  Av\u001b[7m\u001b[8m_\u001b[28m\u001b[27m\u001b[2B"]
[4.582805, "o", "\u001b[999D\u001b[4A\u001b[2B\u001b[2K\u001b[G\u001b[36m│\u001b[39m  Ave\u001b[7m\u001b[8m_\u001b[28m\u001b[27m\u001b[2B\u001b[999D\u001b[4A\u001b[2B\u001b[2K\u001b[G\u001b[36m│\u001b[39m  Aver\u001b[7m\u001b[8m_\u001b[28m\u001b[27m\u001b[2B"]
[4.583354, "o", "\u001b[999D\u001b[4A\u001b[2B\u001b[2K\u001b[G\u001b[36m│\u001b[39m  Avery\u001b[7m\u001b[8m_\u001b[28m\u001b[27m\u001b[2B"]
[4.584019, "o", "\u001b[999D\u001b[4A\u001b[1B\u001b[J\u001b[32m◇\u001b[39m  You'll need a name in these lands. What do they call you?\r\r\n\u001b[90m│\u001b[39m  \u001b[2mAvery\u001b[22m"]
[4.584249, "o", "\r\r\n"]
[4.584381, "o", "\u001b[?25h"]
[4.584497, "o", "\u001b[90m│\u001b[39m\r\r\n\u001b[32m◆\u001b[39m  Commander Avery — set. Every agent in this system answers to you.\r\r\n"]
[4.58622, "o", "\u001b[?25l\u001b[90m│\u001b[39m\r\r\n\u001b[36m◆\u001b[39m  Your starter squad. ~150 agents stand by; you start with a few who are excellent.\r\r\n\u001b[36m│\u001b[39m  \u001b[32m●\u001b[39m FOUNDER'S SQUAD \u001b[2m(Strategic · Commercial · High-stakes)\u001b[22m\r\r\n\u001b[36m│\u001b[39m  \u001b[2m○\u001b[22m \u001b[2mBUILDER'S SQUAD\u001b[22m\r\r\n\u001b[36m│\u001b[39m  \u001b[2m○\u001b[22m \u001b[2mOPERATOR'S SQUAD\u001b[22m\r\r\n\u001b[36m└\u001b[39m\r\r\n"]
[5.091249, "o", "\u001b[999D\u001b[6A\u001b[1B\u001b[J\u001b[32m◇\u001b[39m  Your starter squad. ~150 agents stand by; you start with a few who are excellent.\r\r\n\u001b[90m│\u001b[39m  \u001b[2mFOUNDER'S SQUAD\u001b[22m"]
[5.091369, "o", "\r\r\n\u001b[?25h"]
[5.091728, "o", "\r\r\n╔══════════════════════════════════════════════════════════════════════╗\r\r\n║ FOUNDER'S SQUAD — your squad                                         ║\r\r\n║                                                                      ║\r\r\n║ Athena — Chief Strategy Officer                                      ║\r\r\n║ Apolline — Chief Sales Strategist                                    ║\r\r\n║ Zélie — Presentation & Deck Design                                   ║\r\r\n║ Leah — Researcher — research gate, informs every mission  (always on)║\r\r\n║ Eva — Talent & Recruiting — pulls agents off the bench  (always on)  ║\r\r\n║                                                                      ║\r\r\n║ Orchestrators: Founder's Office · Revenue                            ║\r\r\n╚═══════════════════════"]
[5.091774, "o", "═══════════════════════════════════════════════╝\r\r\n\u001b[2m  Zélie designs your decks — but no narrative writer ships with this squad.\u001b[22m\r\r\n\u001b[2m  So \"frame your investor pitch\" is your natural FIRST RECRUIT, not a day-one promise.\u001b[22m\r\r\n"]
[5.093448, "o", "\u001b[?25l\u001b[90m│\u001b[39m\r\r\n\u001b[36m◆\u001b[39m  Your conductor. This platform is Tess OS; the conductor is the command-layer\r\r\nintelligence you're about to name — the one who routes your missions and briefs\r\r\nyour squad. Its default name is Tess, but this is your system.\r\r\nWhat will you call your conductor?  (Enter to keep Tess)\r\r\n\u001b[36m│\u001b[39m  \u001b[7mT\u001b[27m\u001b[2mess\u001b[22m\r\r\n\u001b[36m└\u001b[39m\r\r\n"]
[5.598614, "o", "\u001b[999D\u001b[7A\u001b[1B\u001b[J\u001b[32m◇\u001b[39m  Your conductor. This platform is Tess OS; the conductor is the command-layer\r\r\nintelligence you're about to name — the one who routes your missions and briefs\r\r\nyour squad. Its default name is Tess, but this is your system.\r\r\nWhat will you call your conductor?  (Enter to keep Tess)\r\r\n\u001b[90m│\u001b[39m  \u001b[2mTess\u001b[22m\r\r\n\u001b[?25h\u001b[90m│\u001b[39m\r\r\n\u001b[32m◆\u001b[39m  Tess — that's the name. Your conductor routes every mission and brings every thread back to you.\r\r\n"]
[5.601392, "o", "\u001b[?25l\u001b[90m│\u001b[39m\r\r\n\u001b[36m◆\u001b[39m  How should Tess show up in the room?\r\r\n\u001b[36m│\u001b[39m  \u001b[32m●\u001b[39m CHIEF OF STAFF \u001b[2m(Formal, precise, executive.)\u001b[22m\r\r\n\u001b[36m│\u001b[39m  \u001b[2m○\u001b[22m \u001b[2mCO-FOUNDER\u001b[22m\r\r\n\u001b[36m│\u001b[39m  \u001b[2m○\u001b[22m \u001b[2mSTRATEGIST\u001b[22m\r\r\n\u001b[36m│\u001b[39m  \u001b[2m○\u001b[22m \u001b[2mGUIDE\u001b[22m\r\r\n\u001b[36m│\u001b[39m  \u001b[2m○\u001b[22m \u001b[2mOPERATOR\u001b[22m\r\r\n\u001b[36m└\u001b[39m\r\r\n"]
[6.112246, "o", "\u001b[999D\u001b[8A\u001b[1B\u001b[J\u001b[32m◇\u001b[39m  How should Tess show up in the room?\r\r\n\u001b[90m│\u001b[39m  \u001b[2mCHIEF OF STAFF\u001b[22m\r\r\n"]
[6.112585, "o", "\u001b[?25h"]
[6.115736, "o", "\u001b[90m│\u001b[39m\r\r\n\u001b[32m◆\u001b[39m  Chief of Staff pathway — set.  \"Tess: Three items are live. I'll brief you in priority order.\"\r\r\n\u001b[90m│\u001b[39m\r\r\n\u001b[32m◇\u001b[39m  \u001b[0mHere's the world you've built\u001b[0m \u001b[90m─────╮\u001b[39m\r\r\n\u001b[90m│\u001b[39m  \u001b[2m\u001b[22m                                   \u001b[90m│\u001b[39m\r\r\n\u001b[90m│\u001b[39m  \u001b[2mCommander Avery\u001b[22m                    \u001b[90m│\u001b[39m\r\r\n\u001b[90m│\u001b[39m  \u001b[2mWorld      The Guild Path\u001b[22m          \u001b[90m│\u001b[39m\r\r\n\u001b[90m│\u001b[39m  \u001b[2msquad      FOUNDER'S SQUAD\u001b[22m         \u001b[90m│\u001b[39m\r\r\n\u001b[90m│\u001b[39m  \u001b[2mConductor  Tess  (chief-of-staff)\u001b[22m  \u001b[90m│\u001b[39m\r\r\n\u001b[90m│\u001b[39m  \u001b[2m\u001b[22m                                   \u001b[90m│\u001b[39m\r\r\n\u001b[90m├─────────────────────────────────────╯\u001b[39m\r\r\n"]
[6.119614, "o", "\u001b[?25l\u001b[90m│\u001b[39m\r\r\n\u001b[36m◆\u001b[39m  Open the gates?\r\r\n\u001b[36m│\u001b[39m  \u001b[32m●\u001b[39m Yes \u001b[2m/\u001b[22m \u001b[2m○\u001b[22m \u001b[2mChange something\u001b[22m\r\r\n\u001b[36m└\u001b[39m\r\r\n"]
[6.622602, "o", "\u001b[999D\u001b[4A\u001b[1B\u001b[J\u001b[32m◇\u001b[39m  Open the gates?\r\r\n\u001b[90m│\u001b[39m  \u001b[2mYes\u001b[22m\r\r\n"]
[6.622928, "o", "\u001b[?25h"]
[9.131788, "o", "\r\r\n─────────────────────────────────────────────────────────\r\r\n  \u001b[1mAssembling your intelligence system.\u001b[22m\r\r\n"]
[9.582837, "o", "  \u001b[32m✓\u001b[39m \u001b[2m✦\u001b[22m Mustering your squad\r\r\n"]
[12.765714, "o", "  \u001b[32m✓\u001b[39m \u001b[2m✦\u001b[22m Marking you as Commander Avery\r\r\n"]
[13.543546, "o", "  \u001b[32m✓\u001b[39m \u001b[2m✦\u001b[22m Attuning Tess to your command\r\r\n"]
[17.048542, "o", "  \u001b[32m✓\u001b[39m \u001b[2m✦\u001b[22m Forging the doctrine\r\r\n"]
[17.107097, "o", "  \u001b[32m✓\u001b[39m \u001b[2m✦\u001b[22m Initialising git repository\r\r\n"]
[17.24647, "o", "  \u001b[32m✓\u001b[39m \u001b[2m✦\u001b[22m Installing gate hooks (tessctl gate install-hooks)\r\r\n"]
[19.327469, "o", "  \u001b[32m✓\u001b[39m tessctl doctor — OK\r\r\n  \u001b[32m✓\u001b[39m tessctl verify — OK\r\r\n"]
[19.327621, "o", "  \u001b[32m✓\u001b[39m git init — repository created\r\r\n  \u001b[32m✓\u001b[39m tessctl gate install-hooks — pre-commit/pre-push hooks + CI workflow live\r\r\n\r\r\n  \u001b[33m!\u001b[39m Local scaffold ready; protected production work remains blocked.\r\r\n\u001b[2m    This project ships with empty policy registries — fail-closed by\r\r\n    design: you register your own verifier and sign-off keys. (The\r\r\n    framework maintainer repository separately registers its own\r\r\n    verifiers, in its own policy, to govern its own development — that\r\r\n    registration is never carried into a scaffolded project.) So\r\r\n    a first governed push can fail closed with no covering APPROVE verdict\r\r\n    found. Do not bypass or disable the hook to represent a change as\r\r\n    protected, or create, register, or sign review authority from this\r\r\n    candidate repository. Record the\r\r\n    gate output and base/head references, then escalate to your project's\r\r\n    key-custody owner for an external custody decision and required\r\r\n    GitHub-check enforcement.\r\r\n\u001b["]
[19.327715, "o", "22m  \u001b[33m★\u001b[3"]
[19.327738, "o", "9m  Local scaffold complete; production protection requires external custody and required GitHub checks.\r\r\n"]
[19.327857, "o", "\r\r\n─────────────────────────────────────────────────────────\r\r\n"]
[19.327904, "o", "Tess — intelligence conductor — online.\r\r\nCommander Avery. Your squad is assembled and standing by:\r\r\n  Athena · Apolline · Zélie · Leah · Eva\r\r\nOrchestrators active: Founder's Office · Revenue.\r\r\nBriefed and ready. What's the first mission?\r\r\n▶  /add-mission [brief your first mission here]\r\r\n─────────────────────────────────────────────────────────\r\r\n\u001b[2mTip: your squad grows when you're ready.  /list-agents · /add-agent (Eva runs intake).\u001b[22m\r\r\n"]
[20.84916, "o", "\r\n$ make receipt-demo    # show me the receipt\r\n"]
[21.873396, "o", "./examples/receipt-demo/run_demo.sh\r\n"]
[21.931855, "o", "\r\n==============================================================================\r\nSTEP 0 — generate ephemeral, demo-only GPG identities\r\n==============================================================================\r\nThese keys are generated fresh for this run only. They are NEVER\r\nregistered in core/policy/policy.yaml's verifier_keys/signoff_keys,\r\nand are destroyed when this script exits. Nothing here creates or\r\ntouches this repository's real trust anchor.\r\n"]
[22.904947, "o", "  Reid (demo/test key)           fingerprint: A6575CD366864098F39BA94934A8A43BF38F712C\r\n  demo-operator (demo/test key)  fingerprint: 66EDD7A474DCD01C5AE8F484B1D676655ACE61AE\r\n"]
[22.904976, "o", "\r\n==============================================================================\r\nSTEP 1 — propose + approve + sign: Receipt 0 (AI-verifier 'verdict')\r\n==============================================================================\r\n"]
[23.120708, "o", "  proposed_action.summary : Proposed a documentation change to docs/AGENT_RECEIPT_SPEC.md\r\n  policy_decision.rule_id : demo-docs-review\r\n"]
[23.120739, "o", "  decision_kind           : verdict (signed by Reid)\r\n"]
[23.120755, "o", "  chain.sequence          : 0 (genesis)\r\n"]
[23.120872, "o", "\r\n==============================================================================\r\nSTEP 2 — propose + approve + sign: Receipt 1 (human 'sign-off', hard floor)\r\n==============================================================================\r\n"]
[23.321928, "o", "  proposed_action.summary : Proposed a sandbox-to-sandbox test funds transfer\r\n  policy_decision.rule_id : demo-money-movement (money_movement)\r\n  decision_kind           : signoff (signed by demo-operator)\r\n  chain.sequence          : 1, chained from Receipt 0\r\n\r\n==============================================================================\r\nSTEP 3 — journal: write the receipt chain + public keys to disk\r\n==============================================================================\r\n"]
[23.32372, "o", "  wrote examples/receipt-demo/.output/receipt-chain.jsonl (2 receipts) + both demo public keys\r\n\r\n==============================================================================\r\nSTEP 4 — verify: run the STANDALONE verifier as an independent third party would\r\n==============================================================================\r\n"]
[25.519515, "o", "CHAIN INTACT (2 receipts) — /private/tmp/tess-os/examples/receipt-demo/.output/receipt-chain.jsonl\r\n\r\n==============================================================================\r\nSTEP 5 — negative control: tamper with Receipt 1 and verify AGAIN\r\n==============================================================================\r\n"]
[25.519619, "o", "Flipping receipt-1's rationale AFTER it was signed, without re-signing —\r\nthis must be REJECTED, not silently accepted.\r\n"]
[25.554102, "o", "receipt /private/tmp/tess-os/examples/receipt-demo/.output/receipt-1-tampered.json: INVALID\r\n  - decision.signature.signed_content_sha256 does not match the CURRENT canonical content — decision was edited/tampered with after signing (fail-closed)\r\n  - receipt_signature.signature.signed_content_sha256 does not match the CURRENT canonical content — receipt_signature was edited/tampered with after signing (fail-closed)\r\n\r\nConfirmed: the tampered receipt was correctly rejected.\r\n\r\n==============================================================================\r\nDEMO COMPLETE\r\n=============================================================================="]
[25.55417, "o", "\r\n"]
[25.554205, "o", "Artifacts written under: examples/receipt-demo/.output\r\n"]
[25.554221, "o", "CHAIN INTACT for the untampered receipts; the tampered copy was rejected.\r\n"]
